# Backend Dockerfile - Multi-stage build for optimal size
ARG RUST_VERSION=1.75
FROM rust:${RUST_VERSION}-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/migrations ./migrations

# Build dependencies only (with dummy source)
RUN mkdir -p src/api src/db src/models/entities src/services && \
    echo "pub mod api; pub mod config; pub mod db; pub mod models; pub mod services;" > src/lib.rs && \
    echo "fn main() {}" > src/main.rs && \
    echo "pub mod entities;" > src/models/mod.rs && \
    echo "pub mod platform_metadata; pub mod metadata_history;" > src/models/entities/mod.rs && \
    echo "pub struct Model;" > src/models/entities/platform_metadata.rs && \
    echo "pub struct Model;" > src/models/entities/metadata_history.rs && \
    cargo build --release 2>&1 | head -100 || true && \
    rm -rf src

# Copy actual source code
COPY backend/src ./src

# Build the actual application with verbose output
RUN cargo build --release 2>&1 | tee /tmp/build.log && \
    strip target/release/myriad-backend

# Runtime stage - minimal image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/myriad-backend /app/myriad-backend

# Create cache directory
RUN mkdir -p /app/cache

# Create a non-root user
RUN useradd -m -u 1000 myriad && \
    chown -R myriad:myriad /app

USER myriad

EXPOSE 3000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["/app/myriad-backend"]
