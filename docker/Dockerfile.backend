# Backend Dockerfile - Multi-stage build for optimal size
FROM rustlang/rust:nightly-bookworm-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/migrations ./migrations

# Copy actual source code early to avoid dummy build issues
COPY backend/src ./src

# Build the application
RUN cargo build --release

# Strip binary if build succeeded
RUN strip target/release/myriad-backend

# Runtime stage - minimal image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/myriad-backend /app/myriad-backend

# Create cache directory
RUN mkdir -p /app/cache

# Create a non-root user
RUN useradd -m -u 1000 myriad && \
    chown -R myriad:myriad /app

USER myriad

EXPOSE 3000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["/app/myriad-backend"]
