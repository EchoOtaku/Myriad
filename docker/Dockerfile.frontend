# Frontend Dockerfile - Multi-stage build
ARG NODE_VERSION=25
ARG PNPM_VERSION=10.28.2
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Disable husky in Docker (no .git directory)
ENV HUSKY=0

# Install dependencies. Node 25 images no longer bundle Corepack, so install
# the repository-pinned pnpm version explicitly.
ARG PNPM_VERSION
RUN npm install --global pnpm@${PNPM_VERSION} && \
    pnpm install --frozen-lockfile

# Copy source code and config
COPY frontend/ ./

# Build argument for backend URL
# 默认为空字符串，使用相对路径（生产环境推荐）
ARG BACKEND_URL=
ENV PUBLIC_API_URL=${BACKEND_URL}

# Build-time version stamp injected into <meta name="myriad-version">.
ARG MYRIAD_VERSION=v0.0.0-dev
ENV PUBLIC_MYRIAD_VERSION=${MYRIAD_VERSION}
ARG MYRIAD_COMMIT_SHA=unknown
ENV PUBLIC_MYRIAD_COMMIT_SHA=${MYRIAD_COMMIT_SHA}

# Build the application
RUN pnpm run build

# Runtime stage - lightweight server
FROM node:${NODE_VERSION}-alpine

ARG MYRIAD_COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=${MYRIAD_COMMIT_SHA}

WORKDIR /app

# Install serve globally and create user
RUN npm install -g serve@14.2.6 && \
    (addgroup -g 1000 myriad 2>/dev/null || addgroup myriad) && \
    (adduser -D -u 1000 -G myriad myriad 2>/dev/null || adduser -D -G myriad myriad)

# Copy built assets from builder
COPY --from=builder --chown=myriad:myriad /app/dist ./dist

# Switch to non-root user
USER myriad

EXPOSE 1102

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:1102 || exit 1

# Serve the built application
# 使用 -s (SPA模式) 将所有未匹配的路由回退到 index.html
# 这样 React Router 可以在客户端处理动态路由（如 /tapp/run/:id）
CMD ["serve", "dist", "-s", "-l", "1102", "--no-clipboard"]
