# Frontend Dockerfile - Multi-stage build
ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-alpine as builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/package-lock.json* ./

# Install dependencies
RUN npm ci --only=production=false

# Copy source code and config
COPY frontend/ ./

# Build argument for backend URL
ARG BACKEND_URL=http://localhost:3000
ENV PUBLIC_API_URL=${BACKEND_URL}

# Build the application
RUN npm run build

# Runtime stage - lightweight server
FROM node:${NODE_VERSION}-alpine

WORKDIR /app

# Install serve globally
RUN npm install -g serve@14 && \
    addgroup -g 1000 myriad && \
    adduser -D -u 1000 -G myriad myriad

# Copy built assets from builder
COPY --from=builder --chown=myriad:myriad /app/dist ./dist

# Switch to non-root user
USER myriad

EXPOSE 4321

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:4321 || exit 1

# Serve the built application
CMD ["serve", "-s", "dist", "-l", "4321", "--no-clipboard"]
