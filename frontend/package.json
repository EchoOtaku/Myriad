{
  "name": "myriad-frontend",
  "type": "module",
  "version": "0.1.0",
  "description": "Frontend for Myriad — a myriad of lights, in one place.",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "build:check": "pnpm typecheck && pnpm build",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; for (const p of ['dist', '.astro']) fs.rmSync(p, { recursive: true, force: true })\"",
    "preview": "astro preview",
    "format": "prettier --write .",
    "lint": "eslint . --ignore-pattern '**/*.md'",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "pnpm lint && pnpm stylelint && pnpm typecheck",
    "typecheck": "astro check",
    "eslint:debug": "eslint --debug .",
    "eslint:inspect": "npx @eslint/config-inspector",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/compiler-rs": "^0.1.4",
    "@astrojs/react": "^5.0.0",
    "astro": "^6.0.3",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.2",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "taze": "^19.10.0",
    "terser": "^5.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
