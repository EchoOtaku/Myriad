{
  "name": "myriad-frontend",
  "type": "module",
  "version": "0.1.0",
  "description": "Frontend for Myriad - Multi-platform personal information aggregation and analysis",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "build:check": "pnpm typecheck && pnpm build",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; for (const p of ['dist', '.astro']) fs.rmSync(p, { recursive: true, force: true })\"",
    "preview": "astro preview",
    "format": "prettier --write .",
    "lint": "eslint . --ignore-pattern '**/*.md'",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "pnpm lint && pnpm stylelint && pnpm typecheck",
    "typecheck": "astro check",
    "eslint:debug": "eslint --debug .",
    "eslint:inspect": "npx @eslint/config-inspector",
    "prepare": "husky install"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7-beta.1",
    "@astrojs/react": "^5.0.0-beta.3",
    "astro": "^6.0.0-beta.11",
    "axios": "^1.13.5",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.34.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "taze": "^19.9.2",
    "terser": "^5.46.0"
  }
}
