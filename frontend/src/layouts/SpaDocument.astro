---
/**
 * Human SPA document. Crawler / share HTML is backend `load_site_branding`.
 * Brand slots here are stamped from GET /api/config/metadata (same fields).
 */
import { Font } from 'astro:assets'
import MachineReadableMetadata from '@components/MachineReadableMetadata.astro'
import NoScriptFallback from '@components/NoScriptFallback.astro'
import LocaleLang from '@components/LocaleLang.astro'
import SiteBrandingBoot from '@components/SiteBrandingBoot.astro'
import ThemeBoot from '@components/ThemeBoot.astro'
import DocumentRuntimeBoot from '@components/DocumentRuntimeBoot.astro'
import PageLoader from '@components/PageLoader.astro'
import StripSpaQuery from '@components/StripSpaQuery.astro'
import App from '../App'
import en from '../i18n/en-US.json' with { type: 'json' }
import { SITE_FONTS } from '../siteFonts.mjs'
import '../styles/tailwind.css'
import '../styles/spa-document.css'

const title = en.chrome.title
const description = en.chrome.description
// Build-time version stamp for the updater health probe; `dev` outside release builds.
const myriadVersion = import.meta.env.PUBLIC_MYRIAD_VERSION || 'dev'
const myriadCommit = import.meta.env.PUBLIC_MYRIAD_COMMIT_SHA || ''
---

<!doctype html>
<html lang="en-US" class="light">
  <head>
    <meta charset="UTF-8" />
    <LocaleLang />
    <StripSpaQuery />
    <meta name="description" content={description} id="meta-description" data-myriad-brand="description" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/webp" href="/favicon.webp" id="favicon-link" data-myriad-brand="favicon" />
    <!-- utils/pwa applies manifest/install meta when pwa_enabled. -->
    <link rel="manifest" href="/manifest.webmanifest" id="pwa-manifest-link" />
    <link rel="apple-touch-icon" href="/icons/pwa/icon-192.png" data-myriad-brand="apple-touch" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Myriad" data-myriad-brand="app-title" />
    <meta property="og:title" content={title} data-myriad-brand="og-title" />
    <meta property="og:description" content={description} data-myriad-brand="og-description" />
    <meta property="og:image" content="" data-myriad-brand="og-image" />
    <title data-myriad-brand="title">{title}</title>
    <script type="application/json" id="myriad-site-brand" data-myriad-brand="json" is:inline>{}</script>
    <SiteBrandingBoot />
    <ThemeBoot />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Build-time version stamp for the updater health probe (stale-cache detect). -->
    <meta name="myriad-version" content={myriadVersion} />
    <meta name="myriad-commit" content={myriadCommit} />
    <MachineReadableMetadata description={description} version={myriadVersion} />

    <!-- Self-hosted Fonts API; no Google Fonts. -->
    {SITE_FONTS.map((font) => (
      <Font cssVariable={font.cssVariable} preload={font.preload ?? false} />
    ))}

    <link rel="dns-prefetch" href="https://api.fuukei.org" />
    <link rel="dns-prefetch" href="https://api.open-meteo.com" />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />
    <link rel="preconnect" href="https://api.fuukei.org" crossorigin />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />

    <DocumentRuntimeBoot />
  </head>
  <body class="antialiased">
    <PageLoader />
    <NoScriptFallback description={description} />

    <div id="app-root">
      <App client:only="react" />
    </div>
  </body>
</html>
