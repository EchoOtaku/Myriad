---
import PageLoader from '../components/PageLoader.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Myriad - Multi-Platform Profile Aggregator' } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- 安全策略 (只保留可以通过 meta 标签设置的) -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {!isDev && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' http://localhost:3000 https://api.github.com https://image.pollinations.ai; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" />}
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <!-- 页面加载器 -->
    <PageLoader />
    <!-- Animated Background -->
    <div id="bg-container" class="fixed inset-0 -z-10 overflow-hidden">
      <!-- Dynamic Wallpaper -->
      <div id="wallpaper" class="absolute inset-0 bg-cover bg-center bg-no-repeat"></div>
      
      <!-- Gradient from middle: Top transparent, Bottom white blur -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent from-[45%] via-white/60 via-[50%] to-white/95"></div>
      
      <!-- Subtle Mesh Gradient - Lower half only -->
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-[45%] left-10 w-96 h-96 bg-green-400/40 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
        <div class="absolute top-[45%] right-10 w-96 h-96 bg-pink-400/40 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
      </div>
      
      <!-- Subtle Grid Pattern -->
      <div class="absolute inset-0 bg-grid-pattern opacity-[0.02]"></div>
    </div>

    <!-- Dynamic Island Navigation - Left Side Vertical -->
    <nav class="nav-container fixed left-6 top-1/2 -translate-y-1/2 z-50 transition-all duration-300" aria-label="主导航">
      <div class="dynamic-island shadow-2xl" role="navigation">
        <div class="flex flex-col items-center gap-1">
          <!-- 主导航组 -->
          <div class="nav-group" data-group="main">
            <a href="/" class="nav-item" title="主页" aria-label="返回主页">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </a>
          </div>
          
          <!-- 配置按钮组（管理员） -->
          <div class="nav-group nav-group-spaced" data-group="config" style="display: none;">
            <a href="/config" id="config-nav-btn" class="nav-item" title="配置" aria-label="系统配置">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </a>
          </div>

          <!-- 用户账户组 -->
          <div class="nav-group nav-group-spaced" data-group="user" id="user-section">
            <!-- 未登录状态 - 显示登录按钮 -->
            <a href="/login" id="login-btn" class="nav-item" title="登录" aria-label="用户登录" style="display: none;">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </a>
            
            <!-- 已登录状态 - 显示用户头像链接 -->
            <a href="/account" id="user-avatar-link" class="nav-item avatar-item p-0 w-11 h-11 overflow-hidden" title="账户管理" aria-label="账户管理" style="display: none;">
              <img id="user-avatar" src="" alt="用户头像" class="w-full h-full object-cover">
            </a>
          </div>

          <!-- 报告功能组（管理员） -->
          <div class="nav-group nav-group-large-spaced" data-group="report" style="display: none;">
            <div class="nav-separator"></div>
            <button id="generate-report-btn" class="nav-item generate-btn" title="生成报告" aria-label="生成数据报告">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <main class="relative z-10">
      <slot />
    </main>

    <style is:global>
      :root {
        --color-primary: #94a3b8;
        --color-secondary: #94a3b8;
        --color-accent: #cbd5e1;
        --color-light: #cbd5e1;
        --color-dark: #475569;
        
        /* 颜色切换平滑过渡 */
        transition: --color-primary 0.6s ease-in-out,
                    --color-secondary 0.6s ease-in-out,
                    --color-accent 0.6s ease-in-out,
                    --color-light 0.6s ease-in-out,
                    --color-dark 0.6s ease-in-out;
      }
      
      @supports not (transition: --color-primary 0.6s) {
        /* 对于不支持 CSS 变量过渡的浏览器，使用通配符 */
        * {
          transition: color 0.6s ease-in-out,
                      background-color 0.6s ease-in-out,
                      border-color 0.6s ease-in-out,
                      box-shadow 0.6s ease-in-out;
        }
      }

      @keyframes blob {
        0%, 100% {
          transform: translate(0, 0) scale(1);
        }
        33% {
          transform: translate(30px, -50px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
      }

      .animate-blob {
        animation: blob 7s infinite;
      }

      .animation-delay-2000 {
        animation-delay: 2s;
      }

      .animation-delay-4000 {
        animation-delay: 4s;
      }

      .bg-grid-pattern {
        background-image: 
          linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 50px 50px;
      }

      body {
        font-family: 'Inter', sans-serif;
        background: #fef3c7;
        color: #1f2937;
      }

      /* Glass effect utility - Bright style */
      .glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.1);
      }

      /* Dynamic Island - 灵动岛样式（垂直布局，流动玻璃材质） */
      .dynamic-island {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 26px;
        padding: 14px 10px;
        border: 2px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
        box-shadow: 0 8px 32px 0 color-mix(in srgb, var(--color-primary) 15%, transparent),
                    inset 0 1px 0 0 rgba(255, 255, 255, 0.8);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        max-height: 85vh;
        /* 硬件加速优化 */
        will-change: transform, opacity;
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
      }

      /* 动态渐变边框动画 */
      .dynamic-island::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 26px;
        padding: 2px;
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--color-primary) 60%, transparent),
          color-mix(in srgb, var(--color-secondary) 40%, transparent),
          color-mix(in srgb, var(--color-accent) 40%, transparent),
          color-mix(in srgb, var(--color-primary) 60%, transparent)
        );
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: border-flow 8s linear infinite;
        background-size: 300% 300%;
        pointer-events: none;
        opacity: 0.8;
        transition: opacity 0.3s ease;
      }

      @keyframes border-flow {
        0%, 100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }

      .dynamic-island:hover {
        padding: 16px 11px;
        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 12px 48px 0 color-mix(in srgb, var(--color-primary) 25%, transparent),
                    inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
        border-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
      }

      .dynamic-island:hover::before {
        opacity: 1;
      }

      /* 导航组 */
      .nav-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* 不同间距的导航组 */
      .nav-group-spaced {
        margin-top: 8px;
      }

      .nav-group-large-spaced {
        margin-top: 0px;
      }

      /* 分隔线样式 - 仅用于生成报告按钮 */
      .nav-separator {
        width: 32px;
        height: 1px;
        background: linear-gradient(to right, 
          transparent, 
          color-mix(in srgb, var(--color-primary) 30%, transparent) 50%, 
          transparent
        );
        margin: 0 0 8px 0;
        transition: all 0.3s ease;
      }

      .nav-group:hover .nav-separator {
        background: linear-gradient(to right, 
          transparent, 
          color-mix(in srgb, var(--color-primary) 50%, transparent) 50%, 
          transparent
        );
      }

      /* Navigation items */
      .nav-item {
        @apply text-gray-500;
        position: relative;
        padding: 10px;
        border-radius: 18px;
        z-index: 10;
        cursor: pointer;
        transform-origin: center;
        /* 添加触摸反馈 */
        -webkit-tap-highlight-color: transparent;
        user-select: none;
        /* 性能优化 */
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), 
                    color 0.2s ease, 
                    background-color 0.2s ease,
                    box-shadow 0.2s ease;
        will-change: transform;
        transform: translateZ(0);
      }

      .nav-item:hover {
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 12%, transparent);
        transform: scale(1.12) translateZ(0);
        box-shadow: 0 2px 8px color-mix(in srgb, var(--color-primary) 20%, transparent);
      }

      .nav-item:active {
        transform: scale(1.02);
        transition-duration: 0.1s;
      }

      /* Active nav item indicator */
      [aria-current="page"].nav-item {
        color: var(--color-primary);
        background: color-mix(in srgb, var(--color-primary) 15%, white);
        box-shadow: 0 2px 10px color-mix(in srgb, var(--color-primary) 25%, transparent);
      }

      [aria-current="page"].nav-item::after {
        content: '';
        position: absolute;
        left: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 5px;
        background: var(--color-primary);
        border-radius: 50%;
        box-shadow: 0 0 8px color-mix(in srgb, var(--color-primary) 60%, transparent);
      }

      /* 用户头像特殊样式 */
      .avatar-item {
        border: 2px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .avatar-item img {
        transition: transform 0.3s ease;
      }

      .avatar-item:hover {
        border-color: var(--color-primary);
        box-shadow: 0 4px 16px color-mix(in srgb, var(--color-primary) 40%, transparent);
      }

      .avatar-item:hover img {
        transform: scale(1.08);
      }

      /* Generate button with gradient border - 简洁旋转版 */
      .generate-btn {
        position: relative;
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--color-primary) 18%, transparent), 
          color-mix(in srgb, var(--color-secondary) 18%, transparent)
        );
        border: 2px solid transparent;
        cursor: pointer;
        z-index: 1;
        border-radius: 18px;
        /* 硬件加速优化 */
        transform: translateZ(0);
        backface-visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* 加载时变圆形 */
      .generate-btn.loading {
        border-radius: 50%;
        animation: pulse-glow 1.5s ease-in-out infinite;
      }

      @keyframes pulse-glow {
        0%, 100% {
          box-shadow: 0 0 20px color-mix(in srgb, var(--color-primary) 40%, transparent);
        }
        50% {
          box-shadow: 0 0 30px color-mix(in srgb, var(--color-secondary) 50%, transparent);
        }
      }

      .generate-btn svg {
        position: relative;
        z-index: 2;
        pointer-events: none;
        transition: transform 0.3s ease;
      }

      .generate-btn:hover svg {
        transform: scale(1.1) rotate(5deg);
      }

      .generate-btn.loading svg {
        animation: icon-pulse 1.5s ease-in-out infinite;
      }

      @keyframes icon-pulse {
        0%, 100% {
          transform: scale(1);
          opacity: 1;
        }
        50% {
          transform: scale(1.15);
          opacity: 0.8;
        }
      }

      /* 边框容器 */
      .generate-btn::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 18px;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
        transition: border-radius 0.3s ease;
      }

      .generate-btn.loading::before {
        border-radius: 50%;
      }

      /* 渐变层 - 旋转 */
      .generate-btn::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 18px;
        padding: 2px;
        z-index: -1;
        pointer-events: none;
        background: conic-gradient(
          from 0deg,
          rgba(34, 197, 94, 0.9),    /* 绿 */
          rgba(251, 191, 36, 0.9),   /* 黄 */
          rgba(236, 72, 153, 0.9),   /* 粉 */
          rgba(139, 92, 246, 0.9),   /* 紫 */
          rgba(59, 130, 246, 0.9),   /* 蓝 */
          rgba(16, 185, 129, 0.9),   /* 青绿 */
          rgba(34, 197, 94, 0.9)     /* 绿（循环） */
        );
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        /* 硬件加速 */
        will-change: transform;
        transform: translateZ(0) rotate(0deg);
        backface-visibility: hidden;
        transition: border-radius 0.3s ease;
        opacity: 0;
      }

      .generate-btn:hover::after {
        opacity: 0.5;
      }

      .generate-btn.loading::after {
        border-radius: 50%;
        animation: rainbow-spin 1.5s linear infinite;
        opacity: 1;
      }

      /* 彩虹边框旋转 */
      @keyframes rainbow-spin {
        0% {
          transform: translateZ(0) rotate(0deg);
        }
        100% {
          transform: translateZ(0) rotate(360deg);
        }
      }

      .generate-btn:hover {
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--color-primary) 28%, transparent), 
          color-mix(in srgb, var(--color-secondary) 28%, transparent)
        );
        transform: scale(1.15) translateZ(0);
        box-shadow: 0 4px 16px color-mix(in srgb, var(--color-primary) 30%, transparent);
      }

      .generate-btn:active {
        transform: scale(1.05);
      }

      /* 响应式设计 */
      @media (max-width: 768px) {
        .nav-container {
          left: 12px !important;
        }

        .dynamic-island {
          padding: 12px 8px;
          border-radius: 22px;
        }

        .dynamic-island:hover {
          padding: 14px 9px;
        }

        .nav-item {
          padding: 9px;
          border-radius: 16px;
        }

        .nav-item svg {
          width: 18px;
          height: 18px;
        }

        .avatar-item {
          width: 40px !important;
          height: 40px !important;
        }

        .nav-group-spaced {
          margin-top: 6px;
        }

        .nav-group-large-spaced {
          margin-top: 0px;
        }

        .nav-separator {
          width: 28px;
          margin: 0 0 6px 0;
        }

        .generate-btn {
          border-radius: 16px;
        }

        .generate-btn.loading {
          border-radius: 50%;
        }
      }

      /* 小屏幕优化 */
      @media (max-width: 480px) {
        .nav-container {
          left: 8px !important;
          top: auto !important;
          bottom: 20px !important;
          transform: none !important;
        }

        .dynamic-island {
          flex-direction: row;
          padding: 10px 12px;
        }

        .dynamic-island > div {
          flex-direction: row;
          gap: 4px;
        }

        .nav-group {
          flex-direction: row;
        }

        .nav-group-spaced {
          margin-top: 0;
          margin-left: 8px;
        }

        .nav-group-large-spaced {
          margin-top: 0;
          margin-left: 8px;
        }

        .nav-separator {
          width: 1px;
          height: 28px;
          margin: 0 4px 0 4px;
          background: linear-gradient(to bottom,
            transparent,
            color-mix(in srgb, var(--color-primary) 30%, transparent) 50%,
            transparent
          );
        }

        [aria-current="page"].nav-item::after {
          left: 50%;
          top: auto;
          bottom: -8px;
          transform: translateX(-50%);
          width: 5px;
          height: 5px;
          border-radius: 50%;
        }
      }

      /* 触摸设备优化 */
      @media (hover: none) and (pointer: coarse) {
        .nav-item {
          min-width: 44px;
          min-height: 44px;
        }

        .nav-item:hover {
          transform: scale(1.05);
        }

        .generate-btn:hover {
          transform: scale(1.08);
        }
      }

      /* 用户头像角标样式 */
      .avatar-badge {
        background: var(--color-primary);
      }

      /* 焦点状态（键盘导航） */
      .nav-item:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 4px;
        border-radius: 18px;
      }

      .generate-btn:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 4px;
      }

      /* Shuffle button - 使用壁纸提取的颜色渐变 */
      .shuffle-btn {
        position: relative;
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--color-primary) 15%, transparent), 
          color-mix(in srgb, var(--color-secondary) 15%, transparent)
        );
        border: 2px solid transparent;
        cursor: pointer;
        z-index: 1;
        color: var(--color-dark);
        font-weight: 500;
        /* 硬件加速优化 */
        transform: translateZ(0);
        backface-visibility: hidden;
      }

      .shuffle-btn::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 16px;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
      }

      .shuffle-btn::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 16px;
        padding: 2px;
        z-index: -1;
        pointer-events: none;
        /* 使用壁纸提取的 primary 和 secondary 颜色 */
        background: linear-gradient(
          135deg,
          var(--color-primary) 0%,
          var(--color-secondary) 100%
        );
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        will-change: transform;
        transform: translateZ(0);
        backface-visibility: hidden;
        /* 平滑过渡颜色变化 */
        transition: background 0.6s ease-in-out;
      }

      .shuffle-btn:hover {
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--color-primary) 25%, transparent), 
          color-mix(in srgb, var(--color-secondary) 25%, transparent)
        );
        box-shadow: 0 4px 15px color-mix(in srgb, var(--color-primary) 30%, transparent);
      }

      /* Smooth scrolling */
      html {
        scroll-behavior: smooth;
      }

      /* Custom scrollbar - Spring theme */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: rgba(254, 243, 199, 0.5);
      }
      ::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--color-primary) 50%, transparent);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: color-mix(in srgb, var(--color-secondary) 70%, transparent);
      }

      /* 动态颜色样式 - 替代内联样式 */
      .progress-bar-fill {
        background-color: var(--color-primary);
        box-shadow: 0 0 10px color-mix(in srgb, var(--color-primary) 50%, transparent);
      }

      /* 进度条宽度通过 JavaScript 动态设置 */
      .progress-bar-fill[data-progress] {
        width: calc(var(--progress, 0) * 1%);
      }

      .report-info-card {
        border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
      }

      .platform-indicator {
        background-color: var(--color-primary);
      }

      .report-card {
        border-color: color-mix(in srgb, var(--color-primary) 20%, transparent);
        box-shadow: 0 4px 20px color-mix(in srgb, var(--color-primary) 10%, transparent);
      }

      .tag-badge {
        background-color: color-mix(in srgb, var(--color-primary) 70%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
      }

      .modal-card {
        border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
      }

      .icon-primary {
        color: var(--color-primary);
      }

      .ai-insight-box {
        background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
        border-left: 4px solid var(--color-primary);
        border-color: color-mix(in srgb, var(--color-primary) 20%, transparent);
      }

      .ai-insight-border {
        border-color: transparent;
      }

      .btn-primary-large {
        background-color: var(--color-primary);
        box-shadow: 0 4px 14px color-mix(in srgb, var(--color-primary) 40%, transparent);
      }

      .btn-secondary-large {
        background-color: var(--color-secondary);
        box-shadow: 0 4px 14px color-mix(in srgb, var(--color-secondary) 40%, transparent);
      }

      .btn-primary {
        background-color: var(--color-primary);
      }

      .btn-secondary {
        background-color: var(--color-secondary);
      }

      /* 弹窗动画 */
      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @keyframes scale-in {
        from {
          opacity: 0;
          transform: scale(0.9) translateY(20px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes pulse-slow {
        0%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0.7;
        }
      }

      @keyframes fade-out {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }

      @keyframes scale-out {
        from {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
        to {
          opacity: 0;
          transform: scale(0.9) translateY(20px);
        }
      }

      .animate-fade-in {
        animation: fade-in 0.25s ease-out;
      }

      .animate-fade-out {
        animation: fade-out 0.2s ease-in;
      }

      .animate-scale-in {
        animation: scale-in 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .animate-scale-out {
        animation: scale-out 0.25s cubic-bezier(0.4, 0, 1, 1);
      }

      .animate-pulse-slow {
        animation: pulse-slow 2s ease-in-out infinite;
      }

      /* 平台链接样式 */
      .platform-link {
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--brand-color) 7%, transparent), 
          color-mix(in srgb, var(--brand-color) 4%, transparent)
        );
        border: 1.5px solid color-mix(in srgb, var(--brand-color) 20%, transparent);
        color: var(--brand-color);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .platform-link::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transition: left 0.5s ease;
      }

      .platform-link:hover::before {
        left: 100%;
      }

      .platform-link:hover {
        background: linear-gradient(135deg, 
          color-mix(in srgb, var(--brand-color) 13%, transparent), 
          color-mix(in srgb, var(--brand-color) 9%, transparent)
        );
        border-color: color-mix(in srgb, var(--brand-color) 35%, transparent);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px color-mix(in srgb, var(--brand-color) 20%, transparent), 
                    0 0 0 1px color-mix(in srgb, var(--brand-color) 9%, transparent);
      }

      .platform-link:active {
        transform: translateY(0);
        transition-duration: 0.1s;
      }

      /* 自定义滚动条 */
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }

      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
        margin: 8px 0;
      }

      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--color-primary) 40%, transparent);
        border-radius: 10px;
      }

      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: color-mix(in srgb, var(--color-primary) 60%, transparent);
      }

      /* 弹窗样式 - 确保在视口中心 */
      .modal-overlay {
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        overflow-y: auto;
      }

      .modal-overlay-portal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9999;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        overflow-y: auto;
        opacity: 0;
        transition: opacity 0.25s ease-out;
      }

      .modal-overlay-portal.modal-opening {
        opacity: 1;
      }

      .modal-overlay-portal.modal-closing {
        opacity: 0;
        transition: opacity 0.2s ease-in;
      }

      .modal-content {
        position: relative;
        background-color: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        border-radius: 1.5rem;
        max-width: 56rem;
        width: 100%;
        max-height: 85vh;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.6);
        transform-origin: center center;
      }

      /* 渐变工具类 */
      .via-primary {
        --tw-gradient-stops: var(--tw-gradient-from), var(--color-primary), var(--tw-gradient-to);
      }

      /* 萌宠走动动画 - 精灵图 */
      .pet-walker {
        transition: left 0.05s linear, transform 0.3s ease;
        display: flex;
        align-items: flex-end; /* 底部对齐 */
      }

      .pet-sprite {
        background-image: var(--pet-image-url, url('https://api.fuukei.org/myriad/frontend/public/furina.png'));
        background-size: 100% 100%; /* 填充整个容器 */
        background-repeat: no-repeat;
        background-position: center bottom; /* 底部对齐 */
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        transition: transform 0.3s ease;
        width: 100%;
        height: 100%;
      }

      .pet-sprite:hover {
        transform: scale(1.1);
      }

      .pixelated-image {
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
      }

      .pet-walker.walking .pet-sprite {
        animation: pet-walk-bounce 0.5s ease-in-out infinite;
      }

      @keyframes pet-walk-bounce {
        0%, 100% {
          transform: translateY(0) scaleY(1);
        }
        25% {
          transform: translateY(-3px) scaleY(1.02) scaleX(0.98);
        }
        50% {
          transform: translateY(0) scaleY(0.98) scaleX(1.02);
        }
        75% {
          transform: translateY(-3px) scaleY(1.02) scaleX(0.98);
        }
      }

      @keyframes pet-excited {
        0% {
          transform: translateY(0) rotate(0deg);
        }
        30% {
          transform: translateY(-12px) rotate(-8deg) scale(1.1);
        }
        60% {
          transform: translateY(-16px) rotate(8deg) scale(1.1);
        }
        100% {
          transform: translateY(0) rotate(0deg);
        }
      }

      .pet-walker.pet-excited {
        animation: pet-excited 0.6s ease-out;
      }

      @keyframes pet-walk-shadow {
        0%, 100% {
          filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        }
        50% {
          filter: drop-shadow(0 3px 6px rgba(0,0,0,0.25));
        }
      }
    </style>

    <script>
      import { extractColorsFromImage, applyColorPalette } from '../utils/colorExtractor';
      import { initTransitionSystem } from '../scripts/page-transition';

      // 全局状态：存储当前显示的壁纸的实际 URL（重定向后的最终 URL）
      let activeWallpaperUrl: string | null = null;
      let wallpaperLoadComplete = false;

      // 缓存接口
      interface WallpaperCache {
        apiUrl: string;
        actualUrl: string;
        timestamp: number;
      }

      // 从 localStorage 获取上次的壁纸缓存
      function getLastWallpaperCache(): WallpaperCache | null {
        try {
          const cached = localStorage.getItem('lastWallpaper');
          if (!cached) return null;
          const data = JSON.parse(cached) as WallpaperCache;
          // 缓存 1 小时内有效
          if (Date.now() - data.timestamp < 60 * 60 * 1000) {
            return data;
          }
          return null;
        } catch {
          return null;
        }
      }

      // 保存壁纸缓存
      function saveWallpaperCache(apiUrl: string, actualUrl: string): void {
        try {
          const cache: WallpaperCache = { apiUrl, actualUrl, timestamp: Date.now() };
          localStorage.setItem('lastWallpaper', JSON.stringify(cache));
        } catch (e) {
          // Failed to save wallpaper cache
        }
      }

      // 获取图片的实际 URL（处理重定向）
      async function getActualImageUrl(apiUrl: string): Promise<string> {
        try {
          // 先获取实际的图片 URL（通过 fetch 会自动跟随重定向）
          const response = await fetch(apiUrl, { method: 'HEAD' });
          const actualUrl = response.url; // 重定向后的最终 URL
          return actualUrl;
        } catch {
          // 如果获取失败，回退到原始 URL
          return apiUrl;
        }
      }

      // 立即显示缓存的壁纸和颜色
      function showCachedWallpaper(wallpaperEl: HTMLElement, cache: WallpaperCache, blur: number): void {
        wallpaperEl.style.backgroundImage = `url(${cache.actualUrl})`;
        wallpaperEl.style.filter = `blur(${blur}px)`;
        activeWallpaperUrl = cache.actualUrl;
        
        // 立即提取并应用缓存的颜色（从 colorExtractor 的缓存）
        extractColorsFromImage(cache.actualUrl).then(colors => {
          if (activeWallpaperUrl === cache.actualUrl) {
            applyColorPalette(colors);
          }
        });
      }

      // Load wallpaper and extract colors (with performance optimization)
      async function loadWallpaperAndColors() {
        // 防止重复加载
        if (wallpaperLoadComplete) return;
        
        try {
          const response = await fetch('http://localhost:3000/api/config');
          const data = await response.json();
          const wallpaperEl = document.getElementById('wallpaper');
          
          if (wallpaperEl && data.ui_config?.wallpaper_url) {
            const apiUrl = data.ui_config.wallpaper_url;
            const blur = data.ui_config.wallpaper_blur || 3;
            
            // 🚀 优化1: 先检查缓存，立即显示
            const cachedWallpaper = getLastWallpaperCache();
            if (cachedWallpaper && cachedWallpaper.apiUrl === apiUrl) {
              showCachedWallpaper(wallpaperEl, cachedWallpaper, blur);
            }
            
            // 🚀 优化2: 后台获取新的实际 URL
            const actualImageUrl = await getActualImageUrl(apiUrl);
            
            // 如果实际 URL 和缓存的一样，不需要更新
            if (cachedWallpaper && cachedWallpaper.actualUrl === actualImageUrl) {
              return;
            }
            
            // URL 不同，需要更新
            activeWallpaperUrl = actualImageUrl;
            
            // 🚀 优化3：并行加载新图片和提取颜色
            const img = new Image();
            img.crossOrigin = 'anonymous';
            
            const colorPromise = extractColorsFromImage(actualImageUrl);
            
            // 加载新图片
            new Promise<void>((resolve, reject) => {
              img.onload = () => {
                if (activeWallpaperUrl === actualImageUrl) {
                  wallpaperEl.style.backgroundImage = `url(${actualImageUrl})`;
                  wallpaperEl.style.filter = `blur(${blur}px)`;
                  resolve();
                } else {
                  reject(new Error('URL changed'));
                }
              };
              img.onerror = () => {
                reject(new Error('Failed to load wallpaper'));
              };
              img.src = actualImageUrl;
            });
            
            // 等待颜色提取完成
            const result = await colorPromise;
            
            if (activeWallpaperUrl === actualImageUrl) {
              // 使用 requestAnimationFrame 优化颜色应用
              requestAnimationFrame(() => {
                applyColorPalette(result);
              });
              
              // 保存新的缓存
              saveWallpaperCache(apiUrl, actualImageUrl);
              wallpaperLoadComplete = true;
            }
            
          } else {
            // 没有配置壁纸，使用默认配色
          }
        } catch (error) {
          // 出错时保持默认配色，不清除颜色
        }
      }
      
      // Set active nav state
      function setActiveNav() {
        const currentPath = window.location.pathname;
        const navItems = document.querySelectorAll('.nav-item:not(.generate-btn)');
        
        navItems.forEach(item => {
          const href = item.getAttribute('href');
          if (href === currentPath || (currentPath === '/' && href === '/')) {
            item.setAttribute('aria-current', 'page');
          } else {
            item.removeAttribute('aria-current');
          }
        });
      }

      // Handle generate report button
      function setupGenerateButton() {
        const generateBtn = document.getElementById('generate-report-btn');
        if (!generateBtn) return;

        generateBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          // 检查是否在首页
          if (window.location.pathname !== '/') {
            window.location.href = '/';
            return;
          }

          // 调用 ReportCards 组件的生成函数
          if (typeof (window as any).generateReport === 'function') {
            generateBtn.classList.add('loading');
            try {
              await (window as any).generateReport();
            } catch (err) {
              // Report generation failed
            } finally {
              generateBtn.classList.remove('loading');
            }
          }
        });
      }
      
      // 页面加载完成处理
      function handlePageLoaded() {
        // 隐藏加载器
        const loader = (window as any).pageLoader;
        if (loader) {
          loader.hide(150);
        }
        
        // 简单的淡入动画
        requestAnimationFrame(() => {
          const main = document.querySelector('main');
          if (main) {
            main.style.opacity = '0';
            requestAnimationFrame(() => {
              main.style.transition = 'opacity 0.3s ease';
              main.style.opacity = '1';
            });
          }
        });
      }
      
      // 优先加载关键功能
      setActiveNav();
      setupAuthUI();
      
      // 等待页面加载完成
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', handlePageLoaded);
      } else {
        // 已经加载完成
        handlePageLoaded();
      }
      
      // 初始化页面切换系统
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
          initTransitionSystem();
        }, { timeout: 1000 });
      } else {
        setTimeout(() => {
          initTransitionSystem();
        }, 50);
      }
      
      // 延迟加载壁纸（使用 requestIdleCallback 或 setTimeout）
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
          loadWallpaperAndColors();
          setupGenerateButton();
        }, { timeout: 2000 });
      } else {
        setTimeout(() => {
          loadWallpaperAndColors();
          setupGenerateButton();
        }, 100);
      }

      // 检查URL中的token参数（OAuth回调）
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token');
      if (token) {
        localStorage.setItem('auth_token', token);
        // 清除URL中的token参数
        window.history.replaceState({}, document.title, window.location.pathname);
        // 刷新用户信息
        loadUserInfo();
      }

      // 用户认证UI设置
      function setupAuthUI() {
        loadUserInfo();

        // 监听登录成功事件
        window.addEventListener('auth-login-success', ((e: CustomEvent) => {
          loadUserInfo();
        }) as EventListener);
      }

      // 加载用户信息
      async function loadUserInfo() {
        const token = localStorage.getItem('auth_token');
        const loginBtn = document.getElementById('login-btn');
        const userAvatarLink = document.getElementById('user-avatar-link');
        const configNavBtn = document.getElementById('config-nav-btn');
        const userSection = document.getElementById('user-section');
        
        // 获取导航组
        const configGroup = document.querySelector('[data-group="config"]') as HTMLElement;
        const userGroup = document.querySelector('[data-group="user"]') as HTMLElement;
        const reportGroup = document.querySelector('[data-group="report"]') as HTMLElement;
        
        if (!token) {
          // 未登录状态 - 只显示登录按钮
          hideWithAnimation(userAvatarLink);
          hideWithAnimation(configGroup);
          hideWithAnimation(reportGroup);
          showWithAnimation(loginBtn);
          
          // 触发自定义事件通知其他组件
          window.dispatchEvent(new CustomEvent('auth-state-changed', { 
            detail: { isAuthenticated: false } 
          }));
          return;
        }

        try {
          const response = await fetch('http://localhost:3000/api/auth/me', {
            headers: {
              'Authorization': `Bearer ${token}`
            }
          });

          if (!response.ok) {
            throw new Error('Failed to get user info');
          }

          const user = await response.json();
          
          // 判断是否为管理员
          const isAdmin = user.is_admin === true;
          
          if (isAdmin) {
            // 管理员 - 隐藏用户区域，显示配置和报告
            hideWithAnimation(loginBtn);
            hideWithAnimation(userAvatarLink);
            showWithAnimation(configGroup);
            showWithAnimation(reportGroup);
          } else {
            // 普通用户 - 显示头像，隐藏配置和报告
            hideWithAnimation(loginBtn);
            hideWithAnimation(configGroup);
            hideWithAnimation(reportGroup);
            
            // 设置头像
            const userAvatar = document.getElementById('user-avatar') as HTMLImageElement;
            if (userAvatar) {
              userAvatar.src = user.avatar_url || 'https://github.com/ghost.png';
              userAvatar.alt = user.username || '用户头像';
            }
            
            showWithAnimation(userAvatarLink);
          }

          // 触发自定义事件通知其他组件
          window.dispatchEvent(new CustomEvent('auth-state-changed', { 
            detail: { isAuthenticated: true, user } 
          }));
          
        } catch (error) {
          // Token无效,清除并显示登录按钮
          localStorage.removeItem('auth_token');
          hideWithAnimation(userAvatarLink);
          hideWithAnimation(configGroup);
          hideWithAnimation(reportGroup);
          showWithAnimation(loginBtn);
          
          window.dispatchEvent(new CustomEvent('auth-state-changed', { 
            detail: { isAuthenticated: false } 
          }));
        }
      }

      // 显示动画辅助函数
      function showWithAnimation(element: HTMLElement | null) {
        if (!element) return;
        
        // 先设置为显示但透明
        element.style.display = '';
        element.style.opacity = '0';
        element.style.transform = 'scale(0.8)';
        
        // 使用 requestAnimationFrame 确保动画生效
        requestAnimationFrame(() => {
          element.style.transition = 'opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
          element.style.opacity = '1';
          element.style.transform = 'scale(1)';
        });
      }

      // 隐藏动画辅助函数
      function hideWithAnimation(element: HTMLElement | null) {
        if (!element) return;
        
        element.style.transition = 'opacity 0.2s ease-out, transform 0.2s ease-out';
        element.style.opacity = '0';
        element.style.transform = 'scale(0.8)';
        
        // 动画结束后真正隐藏
        setTimeout(() => {
          element.style.display = 'none';
        }, 200);
      }
    </script>
  </body>
