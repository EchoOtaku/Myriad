<section class="bg-gradient-to-br from-primary-500 to-primary-700 text-white py-20">
  <div class="container mx-auto px-4 text-center">
    <h1 class="text-5xl font-bold mb-4">Welcome to Myriad</h1>
    <p class="text-xl mb-8 opacity-90">
      Aggregate your digital presence across multiple platforms and gain AI-powered insights
    </p>
    <div class="flex gap-4 justify-center">
      <a
        href="/config"
        class="bg-white text-primary-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition"
      >
        Get Started
      </a>
      <a
        href="#features"
        class="border-2 border-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-primary-700 transition"
      >
        Learn More
      </a>
    </div>
  </div>
</section>

<section id="features" class="py-16">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12">Features</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
        <div class="text-4xl mb-4">🔗</div>
        <h3 class="text-xl font-semibold mb-2">Multi-Platform Integration</h3>
        <p class="text-gray-600 dark:text-gray-400">
          Connect GitHub, Twitter, LinkedIn, and more to aggregate your digital footprint
        </p>
      </div>
      <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
        <div class="text-4xl mb-4">🤖</div>
        <h3 class="text-xl font-semibold mb-2">AI-Powered Analysis</h3>
        <p class="text-gray-600 dark:text-gray-400">
          Get intelligent insights about your online presence using advanced AI models
        </p>
      </div>
      <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
        <div class="text-4xl mb-4">📊</div>
        <h3 class="text-xl font-semibold mb-2">Beautiful Visualizations</h3>
        <p class="text-gray-600 dark:text-gray-400">
          View your data through interactive charts and comprehensive dashboards
        </p>
      </div>
    </div>
  </div>
</section>
