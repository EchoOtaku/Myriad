---
/**
 * 页面加载过渡组件
 * 提供流畅自然的页面切换体验
 */
---

<div id="page-loader" class="page-loader" aria-live="polite" aria-busy="true">
  <div class="loader-content">
    <!-- 简洁的旋转圆环 -->
    <div class="loader-spinner"></div>
  </div>
</div>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 1;
    pointer-events: all;
    transition: opacity 0.3s ease;
    
    /* 性能优化 */
    will-change: opacity;
    transform: translateZ(0);
  }

  /* 隐藏状态 */
  .page-loader.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loader-content {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 简洁的旋转圆环 */
  .loader-spinner {
    width: 48px;
    height: 48px;
    border: 3px solid rgba(148, 163, 184, 0.2);
    border-top-color: var(--color-primary, #94a3b8);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .loader-spinner {
      width: 40px;
      height: 40px;
      border-width: 2.5px;
    }
  }

  /* 减少动画（无障碍） */
  @media (prefers-reduced-motion: reduce) {
    .loader-spinner {
      animation: none;
      border-top-color: var(--color-primary, #94a3b8);
      border-right-color: var(--color-primary, #94a3b8);
    }
  }
</style>

<script>
  /**
   * 页面加载器控制类
   */
  class PageLoader {
    private loader: HTMLElement | null;
    private isShowing: boolean = true;
    private hideTimeout: number | null = null;

    constructor() {
      this.loader = document.getElementById('page-loader');
      console.log('🔄 [PageLoader] Initialized');
    }

    /**
     * 显示加载器
     */
    show(): void {
      if (!this.loader) return;

      if (this.hideTimeout) {
        clearTimeout(this.hideTimeout);
        this.hideTimeout = null;
      }

      this.loader.classList.remove('hidden');
      this.loader.setAttribute('aria-busy', 'true');
      this.isShowing = true;
    }

    /**
     * 隐藏加载器
     */
    hide(delay: number = 200): void {
      if (!this.loader) return;

      this.hideTimeout = window.setTimeout(() => {
        if (this.loader) {
          this.loader.classList.add('hidden');
          this.loader.setAttribute('aria-busy', 'false');
          this.isShowing = false;
          console.log('✅ [PageLoader] Hidden');
        }
      }, delay);
    }

    /**
     * 检查是否正在显示
     */
    isActive(): boolean {
      return this.isShowing;
    }
  }

  // 创建全局实例
  if (typeof window !== 'undefined') {
    (window as any).pageLoader = new PageLoader();
  }
</script>
