---
import Layout from '@layouts/Layout.astro';
import ConfigForm from '@components/ConfigForm';

const title = 'Configuration - Myriad';
---

<Layout title={title}>
  <div class="min-h-screen px-6 py-20">
    <div class="max-w-7xl mx-auto">
      <!-- 标签栏 -->
      <div class="flex justify-center mb-8">
        <div class="glass rounded-2xl p-2 inline-flex gap-2">
          <button
            id="tab-config"
            class="tab-button active px-8 py-3 rounded-xl font-semibold transition-all duration-300"
          >
            ⚙️ 配置管理
          </button>
          <button
            id="tab-debug"
            class="tab-button px-8 py-3 rounded-xl font-semibold transition-all duration-300"
          >
            🐛 调试信息
          </button>
        </div>
      </div>

      <!-- 配置页面内容 -->
      <div id="content-config" class="tab-content">
        <ConfigForm client:load />
      </div>

      <!-- 调试页面内容 -->
      <div id="content-debug" class="tab-content hidden">
        <div class="max-w-6xl mx-auto">
          <!-- 原始元数据 -->
          <div class="mb-8">
            <div class="glass rounded-2xl p-6">
              <div class="flex justify-between items-center mb-4">
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center text-blue-600 text-2xl">
                    📋
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-800">API 原始元数据</h3>
                    <p class="text-sm text-gray-600 mt-1">查看从各平台API获取的原始数据</p>
                  </div>
                </div>
                <button
                  id="fetch-metadata"
                  class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-2xl transition-all duration-300 flex items-center space-x-2 shadow-lg"
                >
                  <span>🔄</span>
                  <span>刷新元数据</span>
                </button>
              </div>
              <div
                id="metadata-container"
                class="mt-4 bg-gray-800 rounded-xl p-6 overflow-auto max-h-[600px]"
              >
                <p class="text-gray-400">点击刷新按钮加载数据...</p>
              </div>
            </div>
          </div>

          <!-- 缓存调试信息 -->
          <div class="mb-8">
            <div class="glass rounded-2xl p-6">
              <div class="flex justify-between items-center mb-4">
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center text-green-600 text-2xl">
                    💾
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-800">缓存详细信息</h3>
                    <p class="text-sm text-gray-600 mt-1">查看报告缓存状态和有效期</p>
                  </div>
                </div>
                <button
                  id="fetch-cache-debug"
                  class="px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-2xl transition-all duration-300 flex items-center space-x-2 shadow-lg"
                >
                  <span>🔄</span>
                  <span>刷新缓存信息</span>
                </button>
              </div>
              <div
                id="cache-debug-container"
                class="mt-4 bg-gray-800 rounded-xl p-6 overflow-auto max-h-[600px]"
              >
                <p class="text-gray-400">点击刷新按钮加载数据...</p>
              </div>
            </div>
          </div>

          <!-- 报告列表 -->
          <div class="mb-8">
            <div class="glass rounded-2xl p-6">
              <div class="flex justify-between items-center mb-4">
                <div class="flex items-center space-x-4">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center text-purple-600 text-2xl">
                    📊
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-800">所有报告列表</h3>
                    <p class="text-sm text-gray-600 mt-1">查看和浏览历史生成的报告</p>
                  </div>
                </div>
                <button
                  id="fetch-reports"
                  class="px-6 py-3 bg-purple-500 hover:bg-purple-600 text-white font-semibold rounded-2xl transition-all duration-300 flex items-center space-x-2 shadow-lg"
                >
                  <span>🔄</span>
                  <span>刷新报告列表</span>
                </button>
              </div>
              <div
                id="reports-container"
                class="mt-4 bg-gray-800 rounded-xl p-6 overflow-auto max-h-[600px]"
              >
                <p class="text-gray-400">点击刷新按钮加载数据...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { API_URL } from '@/config';

  // 标签切换功能
  const tabConfig = document.getElementById('tab-config');
  const tabDebug = document.getElementById('tab-debug');
  const contentConfig = document.getElementById('content-config');
  const contentDebug = document.getElementById('content-debug');

  function switchTab(tab: 'config' | 'debug') {
    if (tab === 'config') {
      tabConfig?.classList.add('active');
      tabDebug?.classList.remove('active');
      contentConfig?.classList.remove('hidden');
      contentDebug?.classList.add('hidden');
    } else {
      tabConfig?.classList.remove('active');
      tabDebug?.classList.add('active');
      contentConfig?.classList.add('hidden');
      contentDebug?.classList.remove('hidden');
    }
  }

  tabConfig?.addEventListener('click', () => switchTab('config'));
  tabDebug?.addEventListener('click', () => switchTab('debug'));

  // ===== 调试功能代码 =====

  // 格式化JSON显示
  function formatJson(data: any) {
    return `<pre class="text-sm text-gray-300 whitespace-pre-wrap">${JSON.stringify(data, null, 2)}</pre>`;
  }

  // 显示加载状态
  function showLoading(containerId: string) {
    const container = document.getElementById(containerId);
    if (container) {
      container.innerHTML = '<p class="text-blue-400 animate-pulse">加载中...</p>';
    }
  }

  // 显示错误信息
  function showError(containerId: string, error: string) {
    const container = document.getElementById(containerId);
    if (container) {
      container.innerHTML = `<p class="text-red-400">❌ ${error}</p>`;
    }
  }

  // 获取原始元数据
  document.getElementById('fetch-metadata')?.addEventListener('click', async () => {
    console.log('🔄 Fetching raw metadata...');
    showLoading('metadata-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/metadata`);
      const result = await response.json();
      
      if (result.success) {
        console.log('✅ Metadata loaded:', result);
        document.getElementById('metadata-container')!.innerHTML = formatJson(result.data);
      } else {
        showError('metadata-container', result.message || 'Failed to load metadata');
      }
    } catch (error) {
      console.error('❌ Error fetching metadata:', error);
      showError('metadata-container', error instanceof Error ? error.message : 'Unknown error');
    }
  });

  // 获取缓存调试信息
  document.getElementById('fetch-cache-debug')?.addEventListener('click', async () => {
    console.log('🔄 Fetching cache debug info...');
    showLoading('cache-debug-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/cache-debug`);
      const result = await response.json();
      
      if (result.success) {
        console.log('✅ Cache info loaded:', result);
        
        // 美化显示缓存信息
        let html = `
          <div class="mb-6 p-4 bg-gradient-to-r from-green-900/30 to-emerald-900/30 rounded-xl border border-green-700/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-green-400 font-semibold text-lg">总缓存数: ${result.total_entries} / ${result.max_entries}</p>
                <p class="text-gray-400 text-sm mt-1">缓存文件: ${result.cache_file}</p>
              </div>
              <div class="text-4xl">💾</div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4">
        `;
        
        for (const entry of result.cache_entries) {
          const statusColor = entry.is_valid ? 'border-green-700/50 bg-green-900/20' : 'border-red-700/50 bg-red-900/20';
          const statusIcon = entry.is_valid ? '✅' : '❌';
          const statusText = entry.is_valid ? '有效' : '已过期';
          html += `
            <div class="border ${statusColor} rounded-xl p-5 hover:shadow-lg transition-all duration-300">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1">
                  <p class="font-mono text-sm text-blue-400 mb-2">🔑 ${entry.cache_key}</p>
                  <div class="grid grid-cols-2 gap-2 text-sm">
                    <div>
                      <span class="text-gray-500">卡片数:</span>
                      <span class="text-gray-300 ml-2 font-semibold">${entry.card_count}</span>
                    </div>
                    <div>
                      <span class="text-gray-500">年龄:</span>
                      <span class="text-gray-300 ml-2">${entry.age.days}天 ${entry.age.hours % 24}小时</span>
                    </div>
                  </div>
                </div>
                <span class="text-2xl ml-4">${statusIcon}</span>
              </div>
              <div class="text-xs text-gray-500 space-y-1 border-t border-gray-700 pt-3 mt-3">
                <p>📌 话题: ${entry.selected_topics.join(', ')}</p>
                <p>🕐 生成: ${new Date(entry.generated_at).toLocaleString()}</p>
                <p>💾 缓存: ${entry.cached_at}</p>
              </div>
              <div class="mt-3 pt-3 border-t border-gray-700">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${entry.is_valid ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400'}">
                  ${statusText}
                </span>
              </div>
            </div>
          `;
        }
        
        html += '</div>';
        document.getElementById('cache-debug-container')!.innerHTML = html;
      } else {
        showError('cache-debug-container', result.message || 'Failed to load cache info');
      }
    } catch (error) {
      console.error('❌ Error fetching cache debug info:', error);
      showError('cache-debug-container', error instanceof Error ? error.message : 'Unknown error');
    }
  });

  // 获取报告列表
  document.getElementById('fetch-reports')?.addEventListener('click', async () => {
    console.log('🔄 Fetching reports list...');
    showLoading('reports-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/reports`);
      const result = await response.json();
      
      if (result.success) {
        console.log('✅ Reports loaded:', result);
        
        // 美化显示报告列表
        let html = `
          <div class="mb-6 p-4 bg-gradient-to-r from-purple-900/30 to-pink-900/30 rounded-xl border border-purple-700/50">
            <div class="flex items-center justify-between">
              <p class="text-purple-400 font-semibold text-lg">总报告数: ${result.total}</p>
              <div class="text-4xl">📊</div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4">
        `;
        
        for (const report of result.reports) {
          html += `
            <div class="border border-purple-700/50 bg-purple-900/20 rounded-xl p-5 cursor-pointer hover:border-purple-500 hover:shadow-lg transition-all duration-300 group" 
                 data-report-id="${report.id}">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1">
                  <p class="font-mono text-sm text-purple-400 mb-2">📄 ${report.id}</p>
                  <div class="grid grid-cols-2 gap-2 text-sm">
                    <div>
                      <span class="text-gray-500">卡片数:</span>
                      <span class="text-gray-300 ml-2 font-semibold">${report.card_count}</span>
                    </div>
                    <div>
                      <span class="text-gray-500">话题数:</span>
                      <span class="text-gray-300 ml-2 font-semibold">${report.topics.length}</span>
                    </div>
                  </div>
                </div>
                <span class="text-2xl ml-4 group-hover:scale-110 transition-transform">👁️</span>
              </div>
              <div class="text-xs text-gray-500 space-y-1 border-t border-gray-700 pt-3 mt-3">
                <p>📌 话题: ${report.topics.join(', ')}</p>
                <p>🕐 生成: ${new Date(report.generated_at).toLocaleString()}</p>
                <p>⏰ 过期: ${new Date(report.expires_at).toLocaleString()}</p>
              </div>
              <div class="mt-3 pt-3 border-t border-gray-700">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/20 text-purple-400">
                  点击查看详情
                </span>
              </div>
            </div>
          `;
        }
        
        html += '</div>';
        document.getElementById('reports-container')!.innerHTML = html;
        
        // 为每个报告添加点击事件查看详情
        document.querySelectorAll('[data-report-id]').forEach(element => {
          element.addEventListener('click', async () => {
            const reportId = (element as HTMLElement).dataset.reportId;
            console.log('📖 Viewing report:', reportId);
            
            try {
              const detailResponse = await fetch(`${API_URL}/api/profile/reports/${reportId}`);
              const detailResult = await detailResponse.json();
              
              if (detailResult.success) {
                // 在新窗口显示完整JSON
                const win = window.open('', '_blank');
                if (win) {
                  win.document.write(`
                    <html>
                      <head>
                        <title>Report ${reportId}</title>
                        <style>
                          body { 
                            background: #1a1a1a; 
                            color: #e0e0e0; 
                            font-family: monospace; 
                            padding: 20px; 
                          }
                          pre { 
                            white-space: pre-wrap; 
                            word-wrap: break-word; 
                          }
                        </style>
                      </head>
                      <body>
                        <h1>Report: ${reportId}</h1>
                        <pre>${JSON.stringify(detailResult.report, null, 2)}</pre>
                      </body>
                    </html>
                  `);
                }
              }
            } catch (error) {
              console.error('❌ Error fetching report detail:', error);
              alert('无法加载报告详情');
            }
          });
        });
      } else {
        showError('reports-container', result.message || 'Failed to load reports');
      }
    } catch (error) {
      console.error('❌ Error fetching reports:', error);
      showError('reports-container', error instanceof Error ? error.message : 'Unknown error');
    }
  });
</script>

<style>
  /* 标签按钮样式 */
  .tab-button {
    color: rgba(0, 0, 0, 0.6);
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    border: 2px solid transparent;
  }

  .tab-button:hover {
    color: rgba(0, 0, 0, 0.8);
    background: rgba(255, 255, 255, 0.4);
    border-color: var(--color-primary);
  }

  .tab-button.active {
    color: white;
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--color-primary) 50%, transparent);
  }

  /* 自定义滚动条样式 */
  #metadata-container::-webkit-scrollbar,
  #cache-debug-container::-webkit-scrollbar,
  #reports-container::-webkit-scrollbar {
    width: 8px;
  }

  #metadata-container::-webkit-scrollbar-track,
  #cache-debug-container::-webkit-scrollbar-track,
  #reports-container::-webkit-scrollbar-track {
    background: #1f2937;
  }

  #metadata-container::-webkit-scrollbar-thumb,
  #cache-debug-container::-webkit-scrollbar-thumb,
  #reports-container::-webkit-scrollbar-thumb {
    background: #4b5563;
    border-radius: 4px;
  }

  #metadata-container::-webkit-scrollbar-thumb:hover,
  #cache-debug-container::-webkit-scrollbar-thumb:hover,
  #reports-container::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }
</style>
