---
import Layout from '@layouts/Layout.astro';
import ModernConfigForm from '../components/ModernConfigForm.tsx';

const title = 'Configuration - Myriad';
---

<Layout title={title}>
  <div class="min-h-screen px-3 xs:px-4 sm:px-6 py-6 sm:py-8 md:py-12 pb-28 sm:pb-24 md:pb-12">
    <div class="max-w-7xl mx-auto">
      <!-- 标签栏 - 紧凑设计 -->
      <div class="flex justify-center mb-4 md:mb-6">
        <div class="glass rounded-xl p-1.5 inline-flex gap-1.5 w-full sm:w-auto shadow-md border tab-container-border">
          <button
            id="tab-config"
            class="tab-button active flex-1 sm:flex-none px-4 sm:px-5 py-2 rounded-lg font-medium text-sm transition-all duration-300 min-h-[40px]"
          >
            <span class="flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>配置</span>
            </span>
          </button>
          <button
            id="tab-debug"
            class="tab-button flex-1 sm:flex-none px-4 sm:px-5 py-2 rounded-lg font-medium text-sm transition-all duration-300 min-h-[40px]"
          >
            <span class="flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <span>数据管理</span>
            </span>
          </button>
        </div>
      </div>

      <!-- 配置页面内容 -->
      <div id="content-config" class="tab-content">
        <!-- 配置状态卡片 -->
        <div class="max-w-6xl mx-auto mb-4 md:mb-6">
          <div class="glass rounded-xl p-4 md:p-5">
            <div class="flex flex-col md:flex-row items-start justify-between gap-4 md:gap-6">
              <!-- 左侧：配置状态信息 -->
              <div class="flex-1 w-full md:w-auto">
                <div class="flex items-center gap-3 mb-3 md:mb-4">
                  <div class="config-status-icon w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center text-xl sm:text-2xl">
                    ⚙️
                  </div>
                  <div>
                    <h2 class="config-title text-base sm:text-lg font-bold">配置状态</h2>
                    <p class="config-subtitle text-xs mt-0.5">当前配置概览和保存状态</p>
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-2 sm:gap-3">
                  <!-- 状态卡片 -->
                  <div class="status-card rounded-lg p-2 sm:p-3 border">
                    <p class="status-label text-xs mb-1 sm:mb-1.5">平台配置</p>
                    <p class="status-value text-sm sm:text-base font-bold" id="platform-count">-</p>
                  </div>
                  <div class="status-card rounded-lg p-2 sm:p-3 border">
                    <p class="status-label text-xs mb-1 sm:mb-1.5">AI 配置</p>
                    <p class="status-value text-sm sm:text-base font-bold" id="ai-status">-</p>
                  </div>
                  <div class="status-card rounded-lg p-2 sm:p-3 border">
                    <p class="status-label text-xs mb-1 sm:mb-1.5">保存状态</p>
                    <p class="text-sm sm:text-base font-bold" id="save-status">
                      <span class="status-unsaved">未保存</span>
                    </p>
                  </div>
                </div>

                <!-- 数据缓存区域 -->
                <div class="status-card mt-3 rounded-lg p-2 sm:p-3 border">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex-1 min-w-0">
                      <p class="status-label text-xs mb-1 sm:mb-1.5">平台数据缓存</p>
                      <div class="flex items-center gap-2 flex-wrap">
                        <p class="status-value text-sm sm:text-base font-bold" id="cache-status">
                          <span class="text-gray-400">未缓存</span>
                        </p>
                        <p class="status-label text-xs" id="cache-time">-</p>
                      </div>
                    </div>
                    <button
                      id="refresh-platform-data"
                      class="refresh-button px-2 sm:px-3 py-1.5 rounded-lg font-semibold text-xs transition-all duration-300 flex items-center gap-1 sm:gap-1.5 shadow-sm shrink-0"
                      title="刷新平台数据"
                    >
                      <span>🔄</span>
                      <span class="hidden sm:inline">刷新</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- 右侧：操作按钮 -->
              <div class="flex md:flex-col gap-2 w-full md:w-auto">
                <button
                  id="save-config"
                  class="save-button flex-1 md:flex-none px-4 sm:px-6 py-2.5 sm:py-3 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-2 shadow-md min-h-[44px]"
                >
                  <span>💾</span>
                  <span class="hidden sm:inline">保存配置</span>
                  <span class="sm:hidden">保存</span>
                </button>
                <button
                  id="reset-config"
                  class="reset-button flex-1 md:flex-none px-4 sm:px-6 py-2.5 sm:py-3 rounded-lg font-semibold text-xs sm:text-sm transition-all duration-300 flex items-center justify-center gap-2 min-h-[44px]"
                >
                  <span>🔄</span>
                  <span>重置</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <ModernConfigForm client:load />
      </div>

      <!-- 调试页面内容 -->
      <div id="content-debug" class="tab-content hidden">
        <div class="max-w-6xl mx-auto">
          <!-- 原始元数据 -->
          <div class="mb-5">
            <div class="glass rounded-xl p-4">
              <div class="flex justify-between items-center mb-3">
                <div class="flex items-center space-x-3">
                  <div class="debug-icon-blue w-10 h-10 rounded-lg flex items-center justify-center text-lg">
                    📋
                  </div>
                  <div>
                    <h3 class="debug-title text-lg font-bold">API 原始元数据</h3>
                    <p class="debug-subtitle text-xs">查看从各平台API获取的原始数据</p>
                  </div>
                </div>
                <button
                  id="fetch-metadata"
                  class="debug-button-blue px-4 py-2 text-white text-sm font-semibold rounded-lg transition-all duration-300 flex items-center space-x-1.5 shadow-md"
                >
                  <span>🔄</span>
                  <span>刷新</span>
                </button>
              </div>
              <div
                id="metadata-container"
                class="debug-container mt-3 rounded-lg p-4 overflow-auto max-h-[500px] text-sm"
              >
                <p class="debug-placeholder text-sm">点击刷新按钮加载数据...</p>
              </div>
            </div>
          </div>

          <!-- 缓存调试信息 -->
          <div class="mb-5">
            <div class="glass rounded-xl p-4">
              <div class="flex justify-between items-center mb-3">
                <div class="flex items-center space-x-3">
                  <div class="debug-icon-green w-10 h-10 rounded-lg flex items-center justify-center text-lg">
                    💾
                  </div>
                  <div>
                    <h3 class="debug-title text-lg font-bold">缓存详细信息</h3>
                    <p class="debug-subtitle text-xs">查看报告缓存状态和有效期</p>
                  </div>
                </div>
                <div class="flex gap-2">
                  <button
                    id="fetch-cache-debug"
                    class="debug-button-green px-4 py-2 text-white text-sm font-semibold rounded-lg transition-all duration-300 flex items-center space-x-1.5 shadow-md"
                  >
                    <span>🔄</span>
                    <span>刷新</span>
                  </button>
                  <button
                    id="delete-cache"
                    class="debug-button-red px-4 py-2 text-white text-sm font-semibold rounded-lg transition-all duration-300 flex items-center space-x-1.5 shadow-md"
                  >
                    <span>🗑️</span>
                    <span>删除缓存</span>
                  </button>
                </div>
              </div>
              <div
                id="cache-debug-container"
                class="debug-container mt-3 rounded-lg p-4 overflow-auto max-h-[500px] text-sm"
              >
                <p class="debug-placeholder text-sm">点击刷新按钮加载数据...</p>
              </div>
            </div>
          </div>

          <!-- 报告列表 -->
          <div class="mb-5">
            <div class="glass rounded-xl p-4">
              <div class="flex justify-between items-center mb-3">
                <div class="flex items-center space-x-3">
                  <div class="debug-icon-purple w-10 h-10 rounded-lg flex items-center justify-center text-lg">
                    📊
                  </div>
                  <div>
                    <h3 class="debug-title text-lg font-bold">所有报告列表</h3>
                    <p class="debug-subtitle text-xs">查看和浏览历史生成的报告</p>
                  </div>
                </div>
                <button
                  id="fetch-reports"
                  class="debug-button-purple px-4 py-2 text-white text-sm font-semibold rounded-lg transition-all duration-300 flex items-center space-x-1.5 shadow-md"
                >
                  <span>🔄</span>
                  <span>刷新</span>
                </button>
              </div>
              <div
                id="reports-container"
                class="debug-container mt-3 rounded-lg p-4 overflow-auto max-h-[500px] text-sm"
              >
                <p class="debug-placeholder text-sm">点击刷新按钮加载数据...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { API_URL } from '@/config';

  // 全局状态
  let isAuthenticated = false;

  // 检查登录状态并控制页面访问
  async function checkAuthStatus() {
    const token = localStorage.getItem('auth_token');
    isAuthenticated = !!token;
    
    if (!isAuthenticated) {
      // 未登录，显示登录提示并阻止访问
      showLoginRequired();
      return false;
    }
    
    // 已登录，隐藏登录提示，显示页面内容
    hideLoginRequired();
    return true;
  }

  // 显示登录提示页面
  function showLoginRequired() {
    const mainContent = document.querySelector('.min-h-screen');
    if (mainContent) {
      mainContent.innerHTML = `
        <div class="flex items-center justify-center min-h-screen">
          <div class="text-center">
            <div class="glass rounded-2xl p-8 max-w-md mx-auto">
              <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-white/80 flex items-center justify-center shadow-md">
                <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-800 mb-2">需要登录</h2>
              <p class="text-gray-600 mb-6">请先登录以访问配置页面</p>
              <a 
                href="/login" 
                class="inline-block px-6 py-3 text-white font-semibold rounded-lg hover:shadow-lg transition-all duration-300 btn-primary-large"
              >
                前往登录
              </a>
            </div>
          </div>
        </div>
      `;
    }
  }

  // 隐藏登录提示，恢复页面内容
  function hideLoginRequired() {
    // 页面内容默认可见，无需额外操作
  }

  // 页面加载时检查登录状态
  if (!await checkAuthStatus()) {
    // 未登录，停止后续初始化
  } else {
    // 已登录，继续初始化页面
    // 只在页面首次加载时调用一次
    await initConfigStatus();
    await checkSaveStatus();
    await checkCacheStatus();
  }

  // 监听认证状态变化
  window.addEventListener('auth-state-changed', ((e: CustomEvent) => {
    isAuthenticated = e.detail.isAuthenticated;
    if (!isAuthenticated) {
      // 登出时，重新显示登录提示
      showLoginRequired();
    } else {
      // 登录时，刷新页面重新加载内容
      window.location.reload();
    }
  }) as EventListener);

  // 标签切换功能
  const tabConfig = document.getElementById('tab-config');
  const tabDebug = document.getElementById('tab-debug');
  const contentConfig = document.getElementById('content-config');
  const contentDebug = document.getElementById('content-debug');

  function switchTab(tab: 'config' | 'debug') {
    if (tab === 'config') {
      tabConfig?.classList.add('active');
      tabDebug?.classList.remove('active');
      contentConfig?.classList.remove('hidden');
      contentDebug?.classList.add('hidden');
    } else {
      tabConfig?.classList.remove('active');
      tabDebug?.classList.add('active');
      contentConfig?.classList.add('hidden');
      contentDebug?.classList.remove('hidden');
    }
  }

  tabConfig?.addEventListener('click', () => switchTab('config'));
  tabDebug?.addEventListener('click', () => switchTab('debug'));

  // 更新配置状态显示
  function updateConfigStatusDisplay(config: any) {
    const platformCount = document.getElementById('platform-count');
    const aiStatus = document.getElementById('ai-status');
    
    if (platformCount && config.platforms) {
      const enabledCount = config.platforms.filter((p: any) => p.enabled).length;
      platformCount.textContent = `${enabledCount}/${config.platforms.length} 已启用`;
    }
    if (aiStatus && config.ai_config) {
      aiStatus.textContent = config.ai_config.enabled ? '✓ 已配置' : '✗ 未配置';
      aiStatus.className = config.ai_config.enabled 
        ? 'text-base font-bold text-green-600' 
        : 'text-base font-bold text-red-600';
    }
  }

  // 初始化配置状态
  async function initConfigStatus() {
    try {
      const response = await fetch(`${API_URL}/api/config`);
      const config = await response.json();
      updateConfigStatusDisplay(config);
    } catch (err) {
      const platformCount = document.getElementById('platform-count');
      const aiStatus = document.getElementById('ai-status');
      if (platformCount) platformCount.textContent = '加载失败';
      if (aiStatus) aiStatus.textContent = '加载失败';
    }
  }
  
  // 注册一次性事件监听器
  window.addEventListener('config-loaded', ((e: CustomEvent) => {
    updateConfigStatusDisplay(e.detail);
  }) as EventListener);

  // 检查配置保存状态
  async function checkSaveStatus() {
    const saveStatus = document.getElementById('save-status');
    
    try {
      // 从配置文件检查是否有有效配置
      const response = await fetch(`${API_URL}/api/config`);
      if (response.ok) {
        const config = await response.json();
        const hasValidConfig = config.platforms?.some((p: any) => p.enabled && p.has_token);
        
        if (saveStatus && hasValidConfig) {
          saveStatus.innerHTML = '<span class="text-green-600">✓ 已保存</span>';
        }
      }
    } catch (error) {
      // Silently fail
    }
  }

  // 检查平台数据缓存状态
  async function checkCacheStatus() {
    const cacheStatus = document.getElementById('cache-status');
    const cacheTime = document.getElementById('cache-time');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/cache-debug`);
      if (response.ok) {
        const result = await response.json();
        
        if (result.success && result.cache_entries && result.cache_entries.length > 0) {
          // 找到最新的有效缓存
          const validCache = result.cache_entries.find((entry: any) => entry.is_valid);
          
          if (validCache && cacheStatus) {
            cacheStatus.innerHTML = '<span class="text-green-600">✓ 已缓存</span>';
            
            if (cacheTime) {
              const cacheDate = new Date(validCache.generated_at);
              const now = new Date();
              const diffMinutes = Math.floor((now.getTime() - cacheDate.getTime()) / 1000 / 60);
              
              if (diffMinutes < 60) {
                cacheTime.textContent = `${diffMinutes}分钟前`;
              } else {
                cacheTime.textContent = cacheDate.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
              }
            }
          } else if (cacheStatus) {
            cacheStatus.innerHTML = '<span class="text-gray-400">未缓存</span>';
            if (cacheTime) cacheTime.textContent = '-';
          }
        } else if (cacheStatus) {
          cacheStatus.innerHTML = '<span class="text-gray-400">未缓存</span>';
          if (cacheTime) cacheTime.textContent = '-';
        }
      }
    } catch (error) {
      // Silently fail
    }
  }

  // 页面加载时检查状态
  initConfigStatus();
  checkSaveStatus();
  checkCacheStatus();

  // 保存和重置按钮
  const saveButton = document.getElementById('save-config');
  const resetButton = document.getElementById('reset-config');
  const saveStatus = document.getElementById('save-status');
  const refreshButton = document.getElementById('refresh-platform-data');

  function waitForConfigSaveResult(timeout = 30000): Promise<{ success: boolean; message?: string }> {
    return new Promise(resolve => {
      
      const handler = (event: Event) => {
        window.clearTimeout(timer);
        window.removeEventListener('config-save-result', handler as EventListener);
        const detail = (event as CustomEvent<{ success: boolean; message?: string }>).detail;
        resolve(detail ?? { success: false, message: '保存结果未知，请重试。' });
      };

      const timer = window.setTimeout(() => {
        window.removeEventListener('config-save-result', handler as EventListener);
        resolve({ success: false, message: '保存超时，请检查后端是否正常运行。' });
      }, timeout);

      window.addEventListener('config-save-result', handler as EventListener);
    });
  }

  function waitForConfigResetResult(timeout = 30000): Promise<{ success: boolean; message?: string }> {
    return new Promise(resolve => {
      
      const handler = (event: Event) => {
        window.clearTimeout(timer);
        window.removeEventListener('config-reset-result', handler as EventListener);
        const detail = (event as CustomEvent<{ success: boolean; message?: string }>).detail;
        resolve(detail ?? { success: false, message: '重置结果未知，请重试。' });
      };

      const timer = window.setTimeout(() => {
        window.removeEventListener('config-reset-result', handler as EventListener);
        resolve({ success: false, message: '重置超时，请检查后端是否正常运行。' });
      }, timeout);

      window.addEventListener('config-reset-result', handler as EventListener);
    });
  }

  // 平台数据刷新按钮
  refreshButton?.addEventListener('click', async () => {
    const cacheStatus = document.getElementById('cache-status');
    const cacheTime = document.getElementById('cache-time');
    const button = refreshButton as HTMLButtonElement;
    
    // 禁用按钮防止重复点击
    button.disabled = true;
    const originalText = button.querySelector('span:last-child')?.textContent;
    const textSpan = button.querySelector('span:last-child');
    if (textSpan) textSpan.textContent = '刷新中...';
    
    if (cacheStatus) {
      cacheStatus.innerHTML = '<span class="text-blue-600 animate-pulse">刷新中...</span>';
    }
    
    try {
      // 调用后端API强制刷新平台数据
      const response = await fetch(`${API_URL}/api/profile/refresh?force=true`, {
        method: 'POST'
      });
      
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      
      const result = await response.json();
      
      if (result.success) {
        
        // 更新缓存状态
        if (cacheStatus) {
          cacheStatus.innerHTML = '<span class="text-green-600">✓ 已缓存</span>';
        }
        if (cacheTime) {
          cacheTime.textContent = '刚刚';
        }
        
        // 触发事件通知ConfigForm更新
        window.dispatchEvent(new CustomEvent('platform-data-refreshed', {
          detail: { timestamp: new Date().toISOString() }
        }));
        
        alert('✓ 平台数据刷新成功！');
      } else {
        throw new Error(result.message || 'Failed to refresh data');
      }
    } catch (error) {
      if (cacheStatus) {
        cacheStatus.innerHTML = '<span class="text-red-600">✗ 刷新失败</span>';
      }
      const errorMsg = error instanceof Error ? error.message : '未知错误';
      alert('✗ 刷新失败：' + errorMsg);
    } finally {
      // 恢复按钮状态
      button.disabled = false;
      if (textSpan && originalText) textSpan.textContent = originalText;
    }
  });

  // 监听缓存状态更新事件
  window.addEventListener('cache-status-update', ((e: CustomEvent) => {
    const cacheStatus = document.getElementById('cache-status');
    const cacheTime = document.getElementById('cache-time');
    
    if (e.detail && e.detail.cached) {
      if (cacheStatus) {
        cacheStatus.innerHTML = '<span class="text-green-600">✓ 已缓存</span>';
      }
      if (cacheTime && e.detail.time) {
        const time = new Date(e.detail.time);
        const now = new Date();
        const diff = Math.floor((now.getTime() - time.getTime()) / 1000 / 60); // 分钟差
        
        if (diff < 60) {
          cacheTime.textContent = `${diff}分钟前`;
        } else {
          cacheTime.textContent = time.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
        }
      }
    }
  }) as EventListener);

  window.addEventListener('config-dirty-state', ((event: CustomEvent<{ dirty: boolean }>) => {
    if (!saveStatus) return;

    if (event.detail?.dirty) {
      saveStatus.innerHTML = '<span class="text-yellow-600">未保存</span>';
    } else {
      // 不调用 checkSaveStatus，避免循环
      saveStatus.innerHTML = '<span class="text-green-600">✓ 已保存</span>';
    }
  }) as EventListener);

  saveButton?.addEventListener('click', async () => {
    if (!isAuthenticated) {
      alert('请先登录');
      return;
    }
    
    const button = saveButton as HTMLButtonElement;
    const buttonText = button.querySelector('span:last-child');
    const originalText = buttonText?.textContent;
    
    button.disabled = true;
    if (buttonText) buttonText.textContent = '保存中...';
    button.classList.add('saving');
    
    // 更新保存状态
    if (saveStatus) {
      saveStatus.innerHTML = '<span class="text-blue-600 animate-pulse">保存中...</span>';
    }
    
    try {
      // 先触发事件让ConfigForm执行保存逻辑
      window.dispatchEvent(new CustomEvent('request-config-save'));

      const result = await waitForConfigSaveResult();

      if (result.success) {
        if (saveStatus) {
          saveStatus.innerHTML = '<span class="text-green-600">✓ 已保存</span>';
        }
        checkSaveStatus();
        alert(result.message || '配置保存成功！');
      } else {
        if (saveStatus) {
          saveStatus.innerHTML = '<span class="text-red-600">✗ 保存失败</span>';
        }
        alert(result.message || '保存失败，请稍后重试');
      }
    } catch (error) {
      if (saveStatus) {
        saveStatus.innerHTML = '<span class="text-red-600">✗ 保存失败</span>';
      }
      alert('保存失败：' + (error instanceof Error ? error.message : '未知错误'));
    } finally {
      // 恢复按钮状态
      button.disabled = false;
      if (buttonText && originalText) buttonText.textContent = originalText;
      button.classList.remove('saving');
    }
  });

  resetButton?.addEventListener('click', async () => {
    if (!isAuthenticated) {
      alert('请先登录');
      return;
    }
    
    if (!confirm('确定要重置为默认配置吗？这将恢复所有设置到初始状态并自动保存。')) {
      return;
    }
    
    const button = resetButton as HTMLButtonElement;
    const buttonText = button.querySelector('span:last-child');
    const originalText = buttonText?.textContent;
    
    // 禁用按钮防止重复点击
    button.disabled = true;
    if (buttonText) buttonText.textContent = '重置中...';
    
    // 更新保存状态
    if (saveStatus) {
      saveStatus.innerHTML = '<span class="text-blue-600 animate-pulse">重置中...</span>';
    }
    
    try {
      // 触发事件通知ConfigForm重置并保存配置
      window.dispatchEvent(new CustomEvent('config-reset'));

      const result = await waitForConfigResetResult();

      if (result.success) {
        if (saveStatus) {
          saveStatus.innerHTML = '<span class="text-green-600">✓ 已保存</span>';
        }
        checkSaveStatus();
        alert(result.message || '配置已重置并保存成功！');
      } else {
        if (saveStatus) {
          saveStatus.innerHTML = '<span class="text-red-600">✗ 重置失败</span>';
        }
        alert(result.message || '重置失败，请稍后重试');
      }
    } catch (error) {
      if (saveStatus) {
        saveStatus.innerHTML = '<span class="text-red-600">✗ 重置失败</span>';
      }
      alert('重置失败：' + (error instanceof Error ? error.message : '未知错误'));
    } finally {
      // 恢复按钮状态
      button.disabled = false;
      if (buttonText && originalText) buttonText.textContent = originalText;
    }
  });

  // ===== 调试功能代码 =====

  // 格式化JSON显示
  function formatJson(data: any) {
    return `<pre class="text-sm text-gray-300 whitespace-pre-wrap">${JSON.stringify(data, null, 2)}</pre>`;
  }

  // 显示加载状态
  function showLoading(containerId: string) {
    const container = document.getElementById(containerId);
    if (container) {
      container.innerHTML = '<p class="text-blue-400 animate-pulse">加载中...</p>';
    }
  }

  // 显示错误信息
  function showError(containerId: string, error: string) {
    const container = document.getElementById(containerId);
    if (container) {
      container.innerHTML = `<p class="text-red-400">❌ ${error}</p>`;
    }
  }

  // 获取原始元数据
  document.getElementById('fetch-metadata')?.addEventListener('click', async () => {
    showLoading('metadata-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/metadata`);
      const result = await response.json();
      
      if (result.success) {
        document.getElementById('metadata-container')!.innerHTML = formatJson(result.data);
      } else {
        showError('metadata-container', result.message || 'Failed to load metadata');
      }
    } catch (error) {
      showError('metadata-container', error instanceof Error ? error.message : 'Unknown error');
    }
  });

  // 获取缓存调试信息
  document.getElementById('fetch-cache-debug')?.addEventListener('click', async () => {
    showLoading('cache-debug-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/cache-debug`);
      const result = await response.json();
      
      if (result.success) {
        
        // 美化显示缓存信息
        let html = `
          <div class="mb-4 p-3 bg-gradient-to-r from-green-900/30 to-emerald-900/30 rounded-lg border border-green-700/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-green-400 font-semibold text-sm">总缓存数: ${result.total_entries} / ${result.max_entries}</p>
                <p class="text-gray-400 text-xs mt-0.5">缓存文件: ${result.cache_file}</p>
              </div>
              <div class="text-2xl">💾</div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-3">
        `;
        
        for (const entry of result.cache_entries) {
          const statusColor = entry.is_valid ? 'border-green-700/50 bg-green-900/20' : 'border-red-700/50 bg-red-900/20';
          const statusIcon = entry.is_valid ? '✅' : '❌';
          const statusText = entry.is_valid ? '有效' : '已过期';
          html += `
            <div class="border ${statusColor} rounded-lg p-3 hover:shadow-lg transition-all duration-300 group relative" data-cache-key="${entry.cache_key}">
              <button 
                class="absolute top-2 right-2 px-2 py-1 bg-red-500 hover:bg-red-600 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity delete-cache-btn z-10"
                data-delete-cache-key="${entry.cache_key}"
              >
                🗑️ 删除
              </button>
              <div class="flex items-start justify-between mb-2 pr-16">
                <div class="flex-1">
                  <p class="font-mono text-xs text-blue-400 mb-1.5">🔑 ${entry.cache_key}</p>
                  <div class="grid grid-cols-2 gap-2 text-xs">
                    <div>
                      <span class="text-gray-500">卡片数:</span>
                      <span class="text-gray-300 ml-1 font-semibold">${entry.card_count}</span>
                    </div>
                    <div>
                      <span class="text-gray-500">年龄:</span>
                      <span class="text-gray-300 ml-1">${entry.age.days}天 ${entry.age.hours % 24}小时</span>
                    </div>
                  </div>
                </div>
                <span class="text-lg ml-2">${statusIcon}</span>
              </div>
              <div class="text-xs text-gray-500 space-y-0.5 border-t border-gray-700 pt-2 mt-2">
                <p>📌 话题: ${entry.selected_topics.join(', ')}</p>
                <p>🕐 生成: ${new Date(entry.generated_at).toLocaleString()}</p>
                <p>💾 缓存: ${entry.cached_at}</p>
              </div>
              <div class="mt-2 pt-2 border-t border-gray-700">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${entry.is_valid ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400'}">
                  ${statusText}
                </span>
              </div>
            </div>
          `;
        }
        
        html += '</div>';
        document.getElementById('cache-debug-container')!.innerHTML = html;
        
        // 为每个缓存条目添加删除按钮事件
        document.querySelectorAll('.delete-cache-btn').forEach(element => {
          element.addEventListener('click', async (e) => {
            e.stopPropagation();
            const cacheKey = (element as HTMLElement).dataset.deleteCacheKey;
            
            if (!confirm(`确定要删除缓存 ${cacheKey} 吗？`)) {
              return;
            }
            
            try {
              const response = await fetch(`${API_URL}/api/profile/reports/${cacheKey}`, {
                method: 'DELETE'
              });
              const result = await response.json();
              
              if (result.success) {
                alert('缓存删除成功！');
                // 刷新列表
                document.getElementById('fetch-cache-debug')?.click();
              } else {
                alert(`删除失败: ${result.message}`);
              }
            } catch (error) {
              alert('删除缓存时出错');
            }
          });
        });
      } else {
        showError('cache-debug-container', result.message || 'Failed to load cache info');
      }
    } catch (error) {
      showError('cache-debug-container', error instanceof Error ? error.message : 'Unknown error');
    }
  });

  // 获取报告列表（展示所有卡片）
  document.getElementById('fetch-reports')?.addEventListener('click', async () => {
    showLoading('reports-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/reports`);
      const result = await response.json();
      
      if (result.success) {
        
        // 获取所有报告的完整数据以展示卡片
        const allCards: any[] = [];
        for (const report of result.reports) {
          try {
            const detailResponse = await fetch(`${API_URL}/api/profile/reports/${report.id}`);
            const detailResult = await detailResponse.json();
            if (detailResult.success && detailResult.report.cards) {
              detailResult.report.cards.forEach((card: any, index: number) => {
                allCards.push({
                  ...card,
                  reportId: report.id,
                  reportGeneratedAt: report.generated_at,
                  indexInReport: index // 记录卡片在报告中的索引
                });
              });
            }
          } catch (error) {
            // Silently ignore failed report loads
          }
        }
        
        // 美化显示卡片列表
        let html = `
          <div class="mb-4 p-3 bg-gradient-to-r from-purple-900/30 to-pink-900/30 rounded-lg border border-purple-700/50">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-purple-400 font-semibold text-sm">总卡片数: ${allCards.length}</p>
                <p class="text-gray-400 text-xs mt-0.5">来自 ${result.total} 个报告</p>
              </div>
              <div class="text-2xl">🃏</div>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-3">
        `;
        
        for (let i = 0; i < allCards.length; i++) {
          const card = allCards[i];
          const cardId = `${card.reportId}_card_${i}`;
          // 找到这个卡片在原报告中的索引
          const cardIndexInReport = card.indexInReport || 0;
          html += `
            <div class="border border-purple-700/50 bg-purple-900/20 rounded-lg p-3 hover:border-purple-500 hover:shadow-lg transition-all duration-300 group relative" 
                 data-card-id="${cardId}" data-report-id="${card.reportId}">
              <button 
                class="absolute top-2 right-2 px-2 py-1 bg-red-500 hover:bg-red-600 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity delete-single-card-btn z-10"
                data-delete-report-id="${card.reportId}"
                data-delete-card-index="${cardIndexInReport}"
                title="删除这张卡片"
              >
                🗑️ 删除
              </button>
              <div class="cursor-pointer view-card" data-card-index="${i}">
                <div class="flex items-start justify-between mb-2 pr-16">
                  <div class="flex-1">
                    <p class="font-bold text-sm text-purple-300 mb-1">${card.title}</p>
                    <p class="font-mono text-xs text-gray-400 mb-1.5">🔑 ${card.topic_id}</p>
                    <div class="flex gap-2 text-xs flex-wrap">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400">
                        📂 ${card.category}
                      </span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-green-500/20 text-green-400">
                        📊 ${card.data_type || 'unknown'}
                      </span>
                    </div>
                  </div>
                  <span class="text-lg ml-2 group-hover:scale-110 transition-transform">👁️</span>
                </div>
                <div class="text-xs text-gray-400 mt-2 pt-2 border-t border-gray-700">
                  <p class="line-clamp-2">${card.content?.summary || '暂无摘要'}</p>
                </div>
                <div class="text-xs text-gray-500 space-y-0.5 mt-2 pt-2 border-t border-gray-700">
                  <p>📄 报告: ${card.reportId}</p>
                  <p>🕐 生成: ${new Date(card.reportGeneratedAt).toLocaleString()}</p>
                </div>
                <div class="mt-2 pt-2 border-t border-gray-700">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-500/20 text-purple-400">
                    点击查看完整内容
                  </span>
                </div>
              </div>
            </div>
          `;
        }
        
        html += '</div>';
        document.getElementById('reports-container')!.innerHTML = html;
        
        // 为每个卡片添加查看详情事件
        document.querySelectorAll('.view-card').forEach(element => {
          element.addEventListener('click', async (e) => {
            e.stopPropagation();
            const cardIndex = parseInt((element as HTMLElement).dataset.cardIndex || '0');
            const card = allCards[cardIndex];
            
            // 在新窗口显示完整卡片JSON
            const win = window.open('', '_blank');
            if (win) {
              const htmlContent = `
                <html>
                  <head>
                    <title>Card: ${card.title}</title>
                    <style>
                      body { 
                        background: #1a1a1a; 
                        color: #e0e0e0; 
                        font-family: monospace; 
                        padding: 20px; 
                      }
                      pre { 
                        white-space: pre-wrap; 
                        word-wrap: break-word; 
                      }
                      h1 { color: #a78bfa; }
                    </style>
                  </head>
                  <body>
                    <h1>🃏 ${card.title}</h1>
                    <pre>${JSON.stringify(card, null, 2)}</pre>
                  </body>
                </html>
              `;
              win.document.open();
              win.document.write(htmlContent);
              win.document.close();
            }
          });
        });

        // 为每个删除单个卡片按钮添加事件
        document.querySelectorAll('.delete-single-card-btn').forEach(element => {
          element.addEventListener('click', async (e) => {
            e.stopPropagation();
            const reportId = (element as HTMLElement).dataset.deleteReportId;
            const cardIndex = parseInt((element as HTMLElement).dataset.deleteCardIndex || '0');
            
            if (!confirm(`确定要删除这张卡片吗？\n这不会删除整个报告。`)) {
              return;
            }
            
            try {
              const response = await fetch(`${API_URL}/api/profile/reports/${reportId}/cards`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ card_index: cardIndex })
              });
              const result = await response.json();
              
              if (result.success) {
                alert(`✓ 卡片 "${result.deleted_card_title || ''}" 删除成功！`);
                // 刷新列表
                document.getElementById('fetch-reports')?.click();
              } else {
                alert(`删除失败: ${result.message}`);
              }
            } catch (error) {
              alert('删除卡片时出错');
            }
          });
        });
      } else {
        showError('reports-container', result.message || 'Failed to load reports');
      }
    } catch (error) {
      showError('reports-container', error instanceof Error ? error.message : 'Unknown error');
    }
  });

  // 删除平台缓存
  document.getElementById('delete-cache')?.addEventListener('click', async () => {
    if (!confirm('确定要删除平台数据缓存吗？删除后需要重新获取所有平台数据。')) {
      return;
    }

    showLoading('cache-debug-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/cache`, {
        method: 'DELETE'
      });
      const result = await response.json();
      
      if (result.success) {
        document.getElementById('cache-debug-container')!.innerHTML = 
          '<p class="text-green-400">✅ 缓存删除成功！点击刷新按钮重新加载。</p>';
        alert('缓存删除成功！');
        // 更新配置页的缓存状态
        checkCacheStatus();
      } else {
        showError('cache-debug-container', result.message || 'Failed to delete cache');
        alert(`删除失败: ${result.message}`);
      }
    } catch (error) {
      showError('cache-debug-container', error instanceof Error ? error.message : 'Unknown error');
      alert('删除缓存时出错');
    }
  });

  // 删除所有报告
  document.getElementById('delete-all-reports')?.addEventListener('click', async () => {
    if (!confirm('确定要删除所有报告吗？此操作不可恢复！')) {
      return;
    }

    showLoading('reports-container');
    
    try {
      const response = await fetch(`${API_URL}/api/profile/reports/all`, {
        method: 'DELETE'
      });
      const result = await response.json();
      
      if (result.success) {
        document.getElementById('reports-container')!.innerHTML = 
          `<p class="text-green-400">✅ ${result.message}</p>`;
        alert(result.message);
      } else {
        showError('reports-container', result.message || 'Failed to delete reports');
        alert(`删除失败: ${result.message}`);
      }
    } catch (error) {
      showError('reports-container', error instanceof Error ? error.message : 'Unknown error');
      alert('删除报告时出错');
    }
  });
</script>

