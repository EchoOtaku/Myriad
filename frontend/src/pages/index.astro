---
import Layout from '@layouts/Layout.astro';
import ReportCards from '@components/ReportCards';

const title = 'Myriad - 数字自我发现';
const description = '一键聚合你的多平台数据，生成AI个人分析报告';
---

<Layout title={title} description={description}>
  <!-- Report Cards Section -->
  <section class="min-h-screen flex items-start justify-center px-6 pt-[calc(25vh)]">
    <ReportCards client:load />
  </section>
</Layout>

<!-- Setup Check Script -->
<script>
  import { API_URL } from '../config';

  // Check if setup is required on page load
  async function checkSetup() {
    try {
      const response = await fetch(`${API_URL}/api/setup/status`);
      if (!response.ok) {
        return;
      }

      const data = await response.json();

      // If setup is required and we're not already on the setup page
      if (data.is_setup_required && window.location.pathname !== '/setup') {
        window.location.href = '/setup';
      }
    } catch (error) {
      // Don't redirect on error - allow user to access the app
    }
  }

  // Run setup check when page loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkSetup);
  } else {
    checkSetup();
  }
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }

  .animate-slide-up {
    animation: slide-up 0.8s ease-out;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
    opacity: 0;
    animation-fill-mode: forwards;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
    opacity: 0;
    animation-fill-mode: forwards;
  }
</style>
