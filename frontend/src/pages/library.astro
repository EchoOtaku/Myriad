---
import Layout from '@layouts/Layout.astro';
import LibraryGrid from '@components/LibraryGrid';

const title = 'Myriad - 资料库';
const description = '探索你的数字世界收藏';
---

<Layout title={title} description={description}>
  <section class="min-h-screen px-3 xs:px-4 sm:px-6 py-8 sm:py-12 pb-28 sm:pb-24 md:pb-12">
    <div class="max-w-7xl mx-auto">
      <!-- 资料库网格 -->
      <LibraryGrid client:load />
    </div>
  </section>
</Layout>
