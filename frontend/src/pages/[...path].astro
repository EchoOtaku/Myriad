---
import { spaPrerenderPaths } from '../spaPaths.mjs'
import SpaDocument from '../layouts/SpaDocument.astro'

/** Astro dest only serves listed paths; prod spa-server falls back to index.html. */
export function getStaticPaths() {
  return spaPrerenderPaths(import.meta.env.DEV).map((route) => ({
    params: { path: route },
  }))
}
---

<SpaDocument />
