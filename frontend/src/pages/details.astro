---
import Layout from '@layouts/Layout.astro';

const title = 'Details - Myriad';
const description = 'View your aggregated platform statistics and analytics';
---

<Layout title={title} description={description}>
  <!-- Centered Details Section -->
  <section class="min-h-screen flex items-center justify-center px-6">
    <div class="max-w-5xl w-full">
      <!-- Main Content Card -->
      <div class="glass rounded-3xl p-12 backdrop-blur-2xl">
        <!-- Header -->
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
              Statistics & Analytics
            </span>
          </h1>
          <p class="text-gray-300">Your digital presence at a glance</p>
        </div>

        <!-- Platform Stats Grid -->
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <!-- GitHub Stats -->
          <div class="glass rounded-2xl p-6 hover:bg-white/10 transition-all duration-300">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center">
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white">GitHub</h3>
                <p class="text-sm text-gray-400">Developer Profile</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Repositories</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Followers</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Stars Received</span>
                <span class="text-white font-semibold">--</span>
              </div>
            </div>
          </div>

          <!-- Bilibili Stats -->
          <div class="glass rounded-2xl p-6 hover:bg-white/10 transition-all duration-300">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500 to-pink-600 flex items-center justify-center">
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white">Bilibili</h3>
                <p class="text-sm text-gray-400">Content Creator</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Followers</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Total Views</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Collections</span>
                <span class="text-white font-semibold">--</span>
              </div>
            </div>
          </div>

          <!-- Steam Stats -->
          <div class="glass rounded-2xl p-6 hover:bg-white/10 transition-all duration-300">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center">
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white">Steam</h3>
                <p class="text-sm text-gray-400">Gaming Profile</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Games Owned</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Level</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Achievements</span>
                <span class="text-white font-semibold">--</span>
              </div>
            </div>
          </div>

          <!-- Twitter Stats -->
          <div class="glass rounded-2xl p-6 hover:bg-white/10 transition-all duration-300">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center">
              </div>
              <div>
                <h3 class="text-lg font-semibold text-white">Twitter</h3>
                <p class="text-sm text-gray-400">Social Profile</p>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Followers</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Tweets</span>
                <span class="text-white font-semibold">--</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-400">Engagement</span>
                <span class="text-white font-semibold">--</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Activity Chart Placeholder -->
        <div class="glass rounded-2xl p-8 text-center mb-8">
          <h3 class="text-xl font-semibold text-white mb-4">Activity Overview</h3>
          <div class="h-48 flex items-center justify-center">
            <div class="text-gray-400">
              <svg class="w-16 h-16 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
              <p class="text-sm">Configure platforms to view analytics</p>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/config"
            class="btn-primary-large inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            配置平台
          </a>
          <button
            class="inline-flex items-center gap-2 px-6 py-3 glass hover:bg-white/10 rounded-xl font-semibold text-white transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            刷新数据
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
