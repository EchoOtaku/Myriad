# =============================================================================
# Myriad Docker Deployment Environment Configuration
# =============================================================================
# This file contains all environment variables needed for Docker deployment
# Copy this to .env and customize the values
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=myriad
POSTGRES_USER=myriad
# SECURITY: Change this password in production!
POSTGRES_PASSWORD=myriad_password_change_me
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=3000

# Security - MUST CHANGE IN PRODUCTION!
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production-use-openssl-rand-base64-32

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:4321,http://localhost:3000,http://localhost:80

# Logging
RUST_LOG=info,myriad_backend=debug
RUST_BACKTRACE=1

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=4321

# Backend API URL (accessible from browser)
PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Build Configuration (optional)
# -----------------------------------------------------------------------------
RUST_VERSION=1.75
NODE_VERSION=20

# =============================================================================
# Quick Start Instructions
# =============================================================================
# 1. Copy this file: cp .env.docker .env
# 2. Update POSTGRES_PASSWORD with a strong password
# 3. Update JWT_SECRET with a secure random string
# 4. Run: docker-compose up -d
# 5. Access the application at http://localhost:4321
# =============================================================================
