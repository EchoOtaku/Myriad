# Live file: ./guard-policy/docker-guard.env
# Guard writes it on first start. scripts/extra/deploy.sh resolves the selected
# UPDATER_TAG and seeds these keys when the file is missing.
#
# Observed Guard image digest for verification/recovery. Normal Compose deployment
# follows UPDATER_TAG; this recorded value does not override the deployment target.
DOCKER_GUARD_IMAGE=docker.io/somekawahitomi/myriad-updater@sha256:REPLACE_WITH_64_HEX_DIGEST

# Generated by scripts/extra/deploy.sh when missing. Do not reuse UPDATE_TOKEN.
GUARD_SELF_UPDATE_TOKEN=

GUARD_COMPOSE_PROJECT_NAME=myriad
GUARD_MYRIAD_DOCKER_NETWORK=myriad-net
GUARD_MYRIAD_ADMIN_NETWORK=myriad-admin-net
GUARD_MYRIAD_DOCKER_GUARD_NETWORK=myriad-docker-guard-net
MYRIAD_GUARD_ENV_FILE=guard-policy/docker-guard.env
