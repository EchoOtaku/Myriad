!/frontend/tests/browser/fixture/memoryGpu.html
!/frontend/tests/browser/fixture/memoryGpu.ts

# Real backend + disposable Postgres business smokes
!/frontend/tests/smoke/
!/frontend/tests/smoke/**

# 本地截图（不提交）
.local-shots/

# Settings framework browser regressions.
!/frontend/tests/browser/settingsEditor.spec.ts
!/frontend/tests/browser/fixture/settingsEditor.html
!/frontend/tests/browser/fixture/settingsEditor.tsx

