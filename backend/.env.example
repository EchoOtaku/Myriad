# Database Configuration
DATABASE_URL=postgres://myriad:password@localhost:5432/myriad

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
RUST_LOG=info,myriad_backend=debug

# Frontend Configuration
FRONTEND_DIST_PATH=../frontend/dist

# AI Service Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here  # Get from: https://makersuite.google.com/app/apikey
GEMINI_MODEL=gemini-pro  # Options: gemini-pro, gemini-pro-vision, gemini-1.5-flash, gemini-1.5-pro

# Platform API Keys and Configuration

## GitHub
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=ghp_your_github_personal_access_token  # Optional: Increases rate limit from 60 to 5000 req/hour

## Bilibili
BILIBILI_UID=123456789  # Your Bilibili User ID (Public API - no authentication required)

## Steam
STEAM_API_KEY=XXXXXXXXXXXXXX  # Get from: https://steamcommunity.com/dev/apikey
STEAM_ID=76561198XXXXXXXXX    # Your Steam ID (17-digit number)

## X (Twitter)
TWITTER_USERNAME=your_twitter_username
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAA  # Get from: developer.twitter.com/en/portal/dashboard

# Security
JWT_SECRET=your-secret-key-here
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# Feature Flags
# Feature Flags
ENABLE_AUTO_FETCH=true
FETCH_INTERVAL_HOURS=24

# UI Configuration
UI_WALLPAPER_URL=https://images.unsplash.com/photo-1579546929518-9e396f3cc809  # Background wallpaper URL
UI_WALLPAPER_BLUR=3  # Blur amount (0-10)
UI_THEME=dark
UI_PRIMARY_COLOR=#6366f1
UI_SECONDARY_COLOR=#8b5cf6
