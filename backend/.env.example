# ============================================
# Myriad Backend Configuration
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DATABASE_URL=

# --------------------------------------------
# Server Configuration
# --------------------------------------------
SERVER_HOST=
SERVER_PORT=
RUST_LOG=

# Frontend static files path (production only)
FRONTEND_DIST_PATH=

# --------------------------------------------
# Security & Authentication
# --------------------------------------------
# JWT secret for session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=

# GitHub OAuth Configuration (可选 - 用于额外用户登录和管理员绑定)
# Register your OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
FRONTEND_URL=

# --------------------------------------------
# AI Service Configuration
# --------------------------------------------
# Google Gemini API Configuration
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Available models:
# - gemini-pro: Best for text generation
# - gemini-pro-vision: For image + text
# - gemini-1.5-flash: Faster, lower cost
# - gemini-1.5-pro: Most capable
# - gemini-2.0-flash-exp: Latest experimental model

# Topic generation style
# Options: balanced, creative, formal, casual, custom:your_custom_style
TOPIC_STYLE=

# --------------------------------------------
# Platform Integration API Keys
# --------------------------------------------

# GitHub Personal Access Token
# Optional: Increases API rate limit from 60 to 5000 req/hour
# Generate at: https://github.com/settings/tokens
GITHUB_USERNAME=
GITHUB_TOKEN=

# Bilibili Configuration
# Your Bilibili User ID (find in your profile URL)
# No authentication required - public API
BILIBILI_UID=

# Steam Configuration
# Get API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_ID=

# Twitter/X Configuration
# Get from: developer.twitter.com/en/portal/dashboard
TWITTER_USERNAME=
TWITTER_BEARER_TOKEN=

# NetEase Cloud Music Configuration
# Your NetEase Cloud Music User ID (find in your profile URL)
NETEASE_USER_ID=

# --------------------------------------------
# UI Customization
# --------------------------------------------
# Wallpaper configuration
UI_WALLPAPER_URL=
UI_WALLPAPER_BLUR=

# Theme settings
UI_THEME=
UI_PRIMARY_COLOR=
UI_SECONDARY_COLOR=

# Pet mascot configuration
PET_ENABLED=
PET_IMAGE_URL=

# --------------------------------------------
# Image Generation
# --------------------------------------------
IMAGE_GEN_ENABLED=
IMAGE_GEN_MODEL=
IMAGE_GEN_WIDTH=
IMAGE_GEN_HEIGHT=

