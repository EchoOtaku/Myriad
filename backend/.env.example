# =============================================================================
# Myriad Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your configuration values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://myriad:password@localhost:5432/myriad

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host address the server will bind to
# Use 0.0.0.0 to accept connections from any network interface
# Use 127.0.0.1 for local-only access
SERVER_HOST=127.0.0.1

# Port the server will listen on
SERVER_PORT=3000

# Logging Configuration
# Levels: error, warn, info, debug, trace
# Format: level,crate_name=level
RUST_LOG=info,myriad_backend=debug

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Path to the built frontend assets directory
# This should point to your compiled Astro/React frontend
FRONTEND_DIST_PATH=../frontend/dist

# -----------------------------------------------------------------------------
# Security Configuration (Required - MUST CHANGE IN PRODUCTION)
# -----------------------------------------------------------------------------
# JWT Secret Key for token signing and verification
# SECURITY WARNING: Generate a strong random secret for production!
# Use a tool like: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-change-in-production

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests
# Add your frontend URL(s) here
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# -----------------------------------------------------------------------------
# Application Configuration Note
# -----------------------------------------------------------------------------
# The following configurations have been moved to the database for better
# management and security. Configure them through the web interface:
#
# 1. Platform API Keys:
#    - GitHub Token
#    - Steam API Key
#    - Bilibili UID
#    - NetEase Music User ID
#    - Twitter/X Bearer Token
#    - LinkedIn Access Token
#
# 2. AI Provider Settings:
#    - AI Provider Selection (Gemini, OpenAI, DeepSeek)
#    - API Keys for each provider
#    - Model names and parameters
#    - Base URLs for custom endpoints
#
# 3. UI Configuration:
#    - Wallpaper URL and blur settings
#    - Pet character settings
#    - Theme preferences
#
# 4. Feature Flags:
#    - Auto-fetch enabled/disabled
#    - Fetch interval
#    - Image generation settings
#
# 5. OAuth Settings:
#    - GitHub OAuth credentials
#    - Redirect URLs
#
# Access these settings at: http://localhost:3000/setup
# Or via API: http://localhost:3000/api/config
#
# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file to .env
# 2. Update DATABASE_URL with your PostgreSQL credentials
# 3. Generate and set a strong JWT_SECRET
# 4. Update CORS_ORIGINS with your frontend URL
# 5. Run database migrations: cargo run --bin migrations
# 6. Start the server: cargo run
# 7. Configure application settings via /setup endpoint
# =============================================================================

