# =============================================================================
# Myriad Production Environment Configuration
# =============================================================================
# 生产环境配置模板 - 复制此文件为 .env 并填写实际值
# cp .env.production.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 🚀 UPDATER REQUIRED (必填，由 scripts/migrate-to-updater.sh 自动生成)
# -----------------------------------------------------------------------------
# 镜像版本固定 tag，由 updater 改写。首次部署填入要运行的版本。
MYRIAD_TAG=v0.1.0
PROXY_TAG=v0.1.0
UPDATER_TAG=v0.1.0

# Compose 项目名固定为 myriad，updater 依赖此约定。
COMPOSE_PROJECT_NAME=myriad

# Updater API 鉴权 token（最少 32 字符）
# 生成方式: openssl rand -base64 36 | tr -d '\n=' | tr '+/' '-_'
UPDATE_TOKEN=

# Updater 跟踪的 release channel: stable | beta | nightly
CHANNEL=stable

# 可选：GitHub Token，用于提升 release API rate limit / 私有仓库
# GITHUB_TOKEN=

# 可选：镜像仓库 mirror 前缀（例如阿里云镜像）
# REGISTRY_MIRROR=mirror.example.com

# 可选：updater 跟踪的仓库
MYRIAD_GITHUB_REPO=somekawahitomi/myriad

# 可选：updater 主动检查更新的频率（秒）
CHECK_INTERVAL_SECS=3600

# 可选：proxy 暴露的 HTTP 端口
HTTP_PORT=80

# 可选：是否启用 /_updater/* 直连通道（默认 false）
# 推荐保持关闭：UI 通过 /api/admin/updater/* 经 backend 鉴权访问。
# 仅在 backend 故障需要救援时打开。
PROXY_ALLOW_DIRECT_UPDATER=false

# -----------------------------------------------------------------------------
# 🔐 REQUIRED SECURITY SETTINGS (必须配置)
# -----------------------------------------------------------------------------

# PostgreSQL 数据库密码（强密码，最少 32 字符）
# 生成方式: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT 密钥（用于用户认证，最少 32 字符）
# 生成方式: openssl rand -base64 32
JWT_SECRET=

# -----------------------------------------------------------------------------
# 🌐 CORS Configuration (生产环境必须配置)
# -----------------------------------------------------------------------------

# 允许访问的前端域名（多个域名用逗号分隔）
# 生产环境必须配置为实际域名，禁止使用 * 或留空
# 示例: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# -----------------------------------------------------------------------------
# 🔧 Optional Configuration (可选配置)
# -----------------------------------------------------------------------------

# 前端 API URL（留空则使用相对路径，推荐）
PUBLIC_API_URL=

# 数据库端口映射（生产环境建议不暴露，留空即可）
# 如需调试可设置为: EXPOSE_DB_PORT=5432
# EXPOSE_DB_PORT=

# 后端服务端口（默认 3000）
# BACKEND_PORT=3000

# 前端服务端口（默认 4321）
# FRONTEND_PORT=4321

# 日志级别（error, warn, info, debug, trace）
# RUST_LOG=info

# -----------------------------------------------------------------------------
# 📝 Application Configuration (应用配置)
# -----------------------------------------------------------------------------
# 注意：以下配置建议通过 Web 界面管理（/api/config），而非环境变量
# 如果在环境变量中配置，启动时会自动同步到数据库
# -----------------------------------------------------------------------------

# --- AI Provider Settings ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-exp

# --- Platform API Keys ---
# GITHUB_TOKEN=
# STEAM_API_KEY=
# BILIBILI_UID=

# --- OAuth Settings (推荐配置方式) ---
#
# 生产环境 OAuth 配置最佳实践：
#
# 方式1: 显式配置（最安全，强烈推荐）
# GITHUB_CLIENT_ID=your_production_client_id
# GITHUB_CLIENT_SECRET=your_production_client_secret
# GITHUB_REDIRECT_URL=https://yourdomain.com/api/auth/github/callback
# FRONTEND_URL=https://yourdomain.com
#
# 方式2: 使用基础URL（适合Docker/Kubernetes）
# BASE_URL=https://yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# GITHUB_CLIENT_ID=your_production_client_id
# GITHUB_CLIENT_SECRET=your_production_client_secret
#
# 注意事项：
# 1. 确保在GitHub OAuth App设置中配置正确的回调URL
# 2. 生产环境必须使用HTTPS
# 3. FRONTEND_URL 用于OAuth成功后重定向到前端
# 4. 如果使用CDN，FRONTEND_URL可能与BASE_URL不同
#
# GitHub OAuth App配置步骤：
# 1. 访问 https://github.com/settings/developers
# 2. 创建新的OAuth App（生产环境专用）
# 3. Authorization callback URL: https://yourdomain.com/api/auth/github/callback
# 4. 复制 Client ID 和 Client Secret 到此配置文件

# =============================================================================
# 安全检查清单
# =============================================================================
# ✅ POSTGRES_PASSWORD 已设置强密码（32+ 字符）
# ✅ JWT_SECRET 已设置强密钥（32+ 字符）
# ✅ CORS_ORIGINS 已配置为实际域名（非 localhost）
# ✅ EXPOSE_DB_PORT 未设置（数据库不暴露到公网）
# ✅ 所有密钥使用 openssl rand -base64 32 生成
# ✅ .env 文件已添加到 .gitignore
# =============================================================================
